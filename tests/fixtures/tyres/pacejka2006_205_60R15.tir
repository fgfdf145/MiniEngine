[MDI_HEADER]
FILE_TYPE                = 'tir'
FILE_VERSION             = 3.0
FILE_FORMAT              = 'ASCII'
$-----------------------------------------------------------------------------------------------
$ Passenger car tyre 205/60R15 91V at 2.2 bar, ISO sign convention.
$ Source: H.B. Pacejka, Tyre and Vehicle Dynamics, 2nd ed. (2006), Appendix 3, Table A3.1
$ (Magic Formula part only; the SWIFT dynamic parameters are left out).
$ The equations these belong to are the book's Eqs. (4.E1-4.E78), "version 2004". They differ
$ in places from MF-Tyre 6.1/6.2 (for example the camber terms of mu_y and K_y), so this file is
$ not meant for an MF 6.1 evaluator. Coefficients the table does not list are zero.
$-----------------------------------------------------------------------------------------------
[UNITS]
LENGTH                   = 'meter'
FORCE                    = 'newton'
ANGLE                    = 'radians'
MASS                     = 'kg'
TIME                     = 'second'
[MODEL]
LONGVL                   = 16.67          $ reference velocity V0
[DIMENSION]
UNLOADED_RADIUS          = 0.313          $ R0
[INERTIA]
MASS                     = 9.3            $ m0
[VERTICAL]
FNOMIN                   = 4000           $ Fz0
[SCALING_COEFFICIENTS]
LFZO                     = 1
LCX                      = 1
LMUX                     = 1
LEX                      = 1
LKX                      = 1
LHX                      = 1
LVX                      = 1
LCY                      = 1
LMUY                     = 1
LEY                      = 1
LKY                      = 1
LKYC                     = 1
LKZC                     = 1
LHY                      = 1
LVY                      = 1
LTR                      = 1
LRES                     = 1
LXAL                     = 1
LYKA                     = 1
LVYKA                    = 1
LS                       = 1
LMX                      = 1
LMY                      = 1
LMUV                     = 0
[LONGITUDINAL_COEFFICIENTS]
