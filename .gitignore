# Ignored build directories are not valid vcpkg install roots; CMake enforces
# .deps/vcpkg_installed/<architecture> for repository-local dependencies.

# Visual Studio
.vs/
.worktrees/
*.VC.db
*.VC.opendb
*.ipch
*.vcxproj.user

# JetBrains CLion
.idea/
cmake-build-*/

# Build
build/
out/
bin/
obj/
vcpkg_installed/

# vcpkg installed packages (persisted outside build dir, but not committed)
.deps/vcpkg_installed/

# NVIDIA DLSS SDK, fetched by scripts/fetch-dlss-sdk.sh (not committed)
.deps/dlss/

# vcpkg internal build artifacts (inside the submodule, ignored at repo level)
.deps/vcpkg/buildtrees/
.deps/vcpkg/packages/
.deps/vcpkg/downloads/
.deps/vcpkg/vcpkg.exe

# CMake
CMakeFiles/
CMakeCache.txt

# Models and textures (kept on disk, not version controlled)
# Their uuid sidecars follow the assets they describe.
assets/**/*.miniengine_asset.yaml
assets/**/*.gltf
assets/**/*.glb
assets/**/*.bin
assets/**/*.fbx
assets/**/*.obj
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.png
assets/**/*.tga
assets/**/*.hdr
assets/**/*.exr
assets/**/*.dds
# Streamed world manifests come with their cells (converters write both), and like them stay out of git.
assets/**/*.stream.yaml
# The render scenes installed from tests/fixtures/render_scenes by scripts/install-render-scenes.*.
assets/scenes/test/
# The Khronos reference comparison's downloads, generated scenes and captures (tools/khronos_reference).
assets/khronos/
assets/scenes/khronos/
assets/**/*.ktx
assets/**/*.ktx2

# ImGui 运行时窗口布局：每次运行都会按当前分辨率写回，不进版本控制。
# 缺失时由 EnsureDefaultDockLayout() 用代码构建默认布局。
/imgui.ini

# glTF 内嵌贴图解码缓存：由 gltf_model_loader 写入的派生数据，不进版本控制。
/.cache/

# Viewport captures (Tools > Capture Viewport)
/captures/

# Stray Visual Studio output folder (MSBuild on the .slnx without CMake).
/x64/

# Agent worktrees and local tool state.
.claude/worktrees/
.superpowers/

# Python bytecode from tools/ scripts.
__pycache__/

# Local backups of hand-patched assets (kept on disk, outside the build tree).
/backups/
