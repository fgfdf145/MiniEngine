+    rt::AccelStructHandle Device::createHandleForNativeAccelStruct(VkAccelerationStructureKHR nativeAccelStruct, IBuffer* dataBuffer, const rt::AccelStructDesc& desc)
+    {
+        if (nativeAccelStruct == VK_NULL_HANDLE)
+            return nullptr;
+
+        AccelStruct* as = new AccelStruct(m_Context);
+        as->desc = desc;
+        as->accelStruct = vk::AccelerationStructureKHR(nativeAccelStruct);
+        as->dataBuffer = dataBuffer;
+        as->ownsAccelStruct = false;
+
+        auto addressInfo = vk::AccelerationStructureDeviceAddressInfoKHR()
+            .setAccelerationStructure(as->accelStruct);
+        as->accelStructDeviceAddress = m_Context.device.getAccelerationStructureAddressKHR(addressInfo);
+
+        return rt::AccelStructHandle::Create(as);
+    }
