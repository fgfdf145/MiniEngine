+    vk::Result BindingLayout::allocateSharedDescriptorSet(vk::DescriptorSet& set, uint32_t& poolIndex)
+    {
+        std::lock_guard<std::mutex> lock(m_SharedPoolMutex);
+
+        const uint32_t setsPerPool = desc.descriptorSetsPerPool;
+        auto allocateInfo = vk::DescriptorSetAllocateInfo()
+            .setDescriptorSetCount(1)
+            .setPSetLayouts(&descriptorSetLayout);
+
+        // The pool that gave out the last set first; a pool with room by count can still be too
+        // fragmented to allocate from, and is passed over then.
+        const uint32_t poolCount = uint32_t(m_SharedPools.size());
+        for (uint32_t step = 0; step < poolCount; ++step)
+        {
+            const uint32_t index = (m_SharedPoolHint + step) % poolCount;
+            SharedDescriptorPool& shared = m_SharedPools[index];
+            if (shared.used >= setsPerPool)
+                continue;
+
+            allocateInfo.setDescriptorPool(shared.pool);
+            if (m_Context.device.allocateDescriptorSets(&allocateInfo, &set) == vk::Result::eSuccess)
+            {
+                ++shared.used;
+                poolIndex = index;
+                m_SharedPoolHint = index;
+                return vk::Result::eSuccess;
+            }
+        }
+
+        std::vector<vk::DescriptorPoolSize> poolSizes = descriptorPoolSizeInfo;
+        for (vk::DescriptorPoolSize& size : poolSizes)
+            size.descriptorCount *= setsPerPool;
+
+        auto poolInfo = vk::DescriptorPoolCreateInfo()
+            .setFlags(vk::DescriptorPoolCreateFlagBits::eFreeDescriptorSet)
+            .setPoolSizeCount(uint32_t(poolSizes.size()))
+            .setPPoolSizes(poolSizes.data())
+            .setMaxSets(setsPerPool);
+
+        SharedDescriptorPool shared;
+        vk::Result res = m_Context.device.createDescriptorPool(&poolInfo, m_Context.allocationCallbacks, &shared.pool);
+        if (res != vk::Result::eSuccess)
+            return res;
+
+        allocateInfo.setDescriptorPool(shared.pool);
+        res = m_Context.device.allocateDescriptorSets(&allocateInfo, &set);
+        if (res != vk::Result::eSuccess)
+        {
+            m_Context.device.destroyDescriptorPool(shared.pool, m_Context.allocationCallbacks);
+            return res;
+        }
+
+        shared.used = 1;
+        m_SharedPools.push_back(shared);
+        poolIndex = uint32_t(m_SharedPools.size() - 1);
+        m_SharedPoolHint = poolIndex;
+        return vk::Result::eSuccess;
+    }
+
+    void BindingLayout::freeSharedDescriptorSet(vk::DescriptorSet set, uint32_t poolIndex)
+    {
+        std::lock_guard<std::mutex> lock(m_SharedPoolMutex);
+
+        SharedDescriptorPool& shared = m_SharedPools[poolIndex];
+        (void)m_Context.device.freeDescriptorSets(shared.pool, 1, &set);
+        --shared.used;
+    }
+
+    vk::DescriptorPool BindingLayout::getSharedDescriptorPool(uint32_t poolIndex)
+    {
+        std::lock_guard<std::mutex> lock(m_SharedPoolMutex);
