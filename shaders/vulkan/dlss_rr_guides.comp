#version 450
#extension GL_GOOGLE_include_directive : require

// The guides DLSS ray reconstruction denoises with (VulkanTaaPass, docs/design/
// 2026-10-07-ray-traced-effects-design.md), from the G-buffer at the render size: the diffuse albedo
// (the base colour without what metal and the dielectric's reflection take), the specular albedo (the
// split-sum directional albedo of the specular lobe, Karis's analytic fit) and the world space
// shading normal with the perceptual roughness in w (NVSDK_NGX_DLSS_Roughness_Mode_Packed). Pixels no
// geometry covered get zero albedos and a normal toward the camera.
// With the plain path tracer's raw paths (guide.hitDistance), also the specular ray's hit distance (the
// path tracer's specular result carries it in its alpha) and the motion vectors of what the
// reflection shows: the virtual image's, the point as far behind the surface along the view ray as the
// ray went in front of it, reprojected through last frame's camera (exact for a flat mirror and a
// still scene), so a glossy reflection is not dragged along with the surface it is seen in.

#include "scene_common.glsl"
#include "gbuffer_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0) uniform sampler2D albedoTexture;   // GB0
layout(set = 1, binding = 1) uniform sampler2D normalTexture;   // GB1
layout(set = 1, binding = 2) uniform sampler2D surfaceTexture;  // GB2
layout(set = 1, binding = 3) uniform sampler2D specularTexture; // GB5
layout(set = 1, binding = 4) uniform sampler2D depthTexture;
layout(set = 1, binding = 5, rgba8) uniform writeonly image2D diffuseAlbedoImage;
layout(set = 1, binding = 6, rgba16f) uniform writeonly image2D specularAlbedoImage;
layout(set = 1, binding = 7, rgba16f) uniform writeonly image2D normalRoughnessImage;
layout(set = 1, binding = 8) uniform sampler2D reflectionsTexture;  // the path tracer's specular result
layout(set = 1, binding = 9, r16f) uniform writeonly image2D hitDistanceImage;
layout(set = 1, binding = 10, rg16f) uniform writeonly image2D reflectionMotionImage;

// DlssMotionPushConstants in engine/renderer/vulkan/taa_pass.cpp, shared with dlss_motion_vectors.comp.
layout(push_constant) uniform GuideConstants
{
    vec2 extent;
    vec2 invExtent;
    vec2 jitterPixels;
    // x: 1 to write the hit distance and the reflections' motion vectors.
    vec2 hitDistance;
}
guide;

// The split sum's (scale, bias) for the GGX lobe (Karis 2014, "Physically Based Shading on Mobile").
vec2 EnvironmentBrdfApprox(float roughness, float NdV)
{
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
    vec4 r = roughness * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NdV)) * r.x + r.y;
    return vec2(-1.04, 1.04) * a004 + r.zw;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(guide.extent))))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) * guide.invExtent;
    float depth = texelFetch(depthTexture, pixel, 0).r;
    vec4 world = ubo.invViewProj * vec4(uv * 2.0 - 1.0, IsFarDepth(depth) ? DEPTH_FAR : depth, 1.0);
    vec3 V = normalize(ubo.cameraWorldPosition.xyz - world.xyz / world.w);
    if (guide.hitDistance.x > 0.0)
    {
        // As dlss_motion_vectors.comp: from where the point is now (unjittered) to where it was, in
        // render pixels. The sky (and a pixel without a specular path, distance 0) moves as the
        // surface point would if it stood still.
        float distance = IsFarDepth(depth) ? 0.0 : texelFetch(reflectionsTexture, pixel, 0).a;
        vec3 surface = world.xyz / world.w;
        vec3 virtualPoint = surface + normalize(surface - ubo.cameraWorldPosition.xyz) * distance;
        vec4 previousClip = ubo.prevViewProj * vec4(virtualPoint, 1.0);
        vec2 previousUv = previousClip.xy / previousClip.w * 0.5 + 0.5;
        vec2 currentUv = uv - guide.jitterPixels * guide.invExtent;
        imageStore(hitDistanceImage, pixel, vec4(distance, 0.0, 0.0, 0.0));
        imageStore(reflectionMotionImage, pixel, vec4((previousUv - currentUv) * guide.extent, 0.0, 0.0));
    }
    if (IsFarDepth(depth))
    {
        imageStore(diffuseAlbedoImage, pixel, vec4(0.0));
        imageStore(specularAlbedoImage, pixel, vec4(0.0));
        imageStore(normalRoughnessImage, pixel, vec4(V, 1.0));
        return;
    }

    vec3 albedo = texelFetch(albedoTexture, pixel, 0).rgb;
    vec3 N = DecodeNormalOctahedral(texelFetch(normalTexture, pixel, 0).rg);
    vec4 surface = texelFetch(surfaceTexture, pixel, 0);
    float metallic = surface.r;
    float roughness = clamp(surface.g, 0.04, 1.0);
    vec3 dielectricF0 = vec3(0.04);
    if ((DecodeShadingFlags(surface.a) & SHADING_FLAG_SPECULAR) != 0u)
    {
        vec3 stored = texelFetch(specularTexture, pixel, 0).rgb;
        dielectricF0 = stored * stored;
    }
    vec3 F0 = mix(dielectricF0, albedo, metallic);
    vec2 split = EnvironmentBrdfApprox(roughness, max(dot(N, V), 1e-4));
    vec3 specularAlbedo = clamp(F0 * split.x + split.y, 0.0, 1.0);
    vec3 diffuseAlbedo = albedo * (1.0 - metallic);

    imageStore(diffuseAlbedoImage, pixel, vec4(diffuseAlbedo, 1.0));
    imageStore(specularAlbedoImage, pixel, vec4(specularAlbedo, 1.0));
    imageStore(normalRoughnessImage, pixel, vec4(N, roughness));
}
