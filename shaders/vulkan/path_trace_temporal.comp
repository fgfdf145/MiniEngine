#version 460
#extension GL_GOOGLE_include_directive : require

// The path tracer's temporal accumulation (VulkanPathTracePass): last frame's average, reprojected
// through the motion vectors, takes this frame's paths in as one more sample, up to the frame's
// history cap; a still image's cap grows every frame, so it converges to the reference. The history is
// read with a bilinear footprint whose taps are each kept only where last frame's surface (its view
// depth and normal, stored beside it) is the one this pixel sees, so a disocclusion starts afresh
// rather than smearing what was in front. The specular channel's history is shortened by its
// roughness while anything moves: a sharp reflection does not move with the surface.

#include "scene_common.glsl"
#include "gbuffer_common.glsl"
#include "path_trace_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// How far last frame's view depth may lie from where this surface was, as a share of it, and how
// closely its normal must agree.
const float DEPTH_TOLERANCE = 0.03;
const float NORMAL_TOLERANCE = 0.85;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(pathTrace.extent))))
    {
        return;
    }
    float depth = texelFetch(ptDepth, pixel, 0).r;
    vec4 rawDiffuse = imageLoad(ptRawDiffuse, pixel);
    vec4 rawSpecular = imageLoad(ptRawSpecular, pixel);
    if (!PathTraceSurfaceShaded(pixel, depth))
    {
        imageStore(ptHistoryDiffuse, pixel, vec4(0.0));
        imageStore(ptHistorySpecular, pixel, vec4(0.0));
        imageStore(ptHistorySurface, pixel, vec4(0.0));
        return;
    }

    vec3 worldPosition = PathTraceWorldPosition(pixel, depth);
    vec3 N = DecodeNormalOctahedral(texelFetch(ptNormal, pixel, 0).rg);
    float viewDepth = (ubo.proj * ubo.view * vec4(worldPosition, 1.0)).w;
    imageStore(ptHistorySurface, pixel, vec4(viewDepth, EncodeNormalOctahedral(N), 0.0));

    vec4 previousDiffuse = vec4(0.0);
    vec4 previousSpecular = vec4(0.0);
    float previousWeight = 0.0;
    if ((pathTrace.flags & PT_FLAG_HISTORY_VALID) != 0u)
    {
        // Where this surface was last frame, and how far from the camera.
        vec2 uv = (vec2(pixel) + 0.5) * pathTrace.invExtent;
        vec2 previousUv = uv - texelFetch(ptVelocity, pixel, 0).rg;
        float previousViewDepth = (ubo.prevViewProj * vec4(worldPosition, 1.0)).w;
        vec2 position = previousUv * pathTrace.extent - 0.5;
        ivec2 base = ivec2(floor(position));
        vec2 f = position - vec2(base);
        for (int tap = 0; tap < 4; ++tap)
        {
            ivec2 offset = ivec2(tap & 1, tap >> 1);
            ivec2 source = base + offset;
            if (any(lessThan(source, ivec2(0))) || any(greaterThanEqual(source, ivec2(pathTrace.extent))))
            {
                continue;
            }
            vec4 surface = texelFetch(ptPreviousSurface, source, 0);
            if (surface.x <= 0.0 || abs(surface.x - previousViewDepth) > DEPTH_TOLERANCE * previousViewDepth ||
                dot(DecodeNormalOctahedral(surface.yz), N) < NORMAL_TOLERANCE)
            {
                continue;
            }
            vec2 bilinear = mix(vec2(1.0) - f, f, vec2(offset));
            float weight = bilinear.x * bilinear.y;
            previousDiffuse += texelFetch(ptPreviousDiffuse, source, 0) * weight;
            previousSpecular += texelFetch(ptPreviousSpecular, source, 0) * weight;
            previousWeight += weight;
        }
    }

    float diffuseCount = 1.0;
    float specularCount = 1.0;
    vec3 diffuse = rawDiffuse.rgb;
    vec3 specular = rawSpecular.rgb;
    if (previousWeight > 1e-3)
    {
        previousDiffuse /= previousWeight;
        previousSpecular /= previousWeight;
        // While the image changes, a glossy reflection keeps a history as short as its lobe is sharp.
        float specularCap = pathTrace.historyCap;
        if (pathTrace.historyCap <= pathTrace.motionFrames)
        {
            specularCap = max(2.0, pathTrace.motionFrames * smoothstep(0.0, 0.5, PathTraceSpecularRoughness(pixel)));
        }
        diffuseCount = min(previousDiffuse.a + 1.0, pathTrace.historyCap);
        specularCount = min(previousSpecular.a + 1.0, specularCap);
        diffuse = mix(previousDiffuse.rgb * pathTrace.historyScale, rawDiffuse.rgb, 1.0 / diffuseCount);
        specular = mix(previousSpecular.rgb * pathTrace.historyScale, rawSpecular.rgb, 1.0 / specularCount);
    }
    imageStore(ptHistoryDiffuse, pixel, vec4(min(diffuse, vec3(65504.0)), diffuseCount));
    imageStore(ptHistorySpecular, pixel, vec4(min(specular, vec3(65504.0)), specularCount));
}
