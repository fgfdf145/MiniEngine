#version 450
#extension GL_GOOGLE_include_directive : require

// Glare on the bloom mip chain of Jimenez 2014 ("Next Generation Post Processing in Call of Duty:
// Advanced Warfare"), weighted as diffraction spreads energy (see engine/renderer/glare.h). One
// shader, four modes, dispatched by VulkanBloomPass in this order:
//   first downsample  SceneTaa -> level 0, 13 taps, Karis average against fireflies;
//   downsample        level i-1 -> level i, 13 taps;
//   upsample          level i = band_i * level i + 3x3 tent of level i+1, from the bottom up;
//   composite         SceneTaa = SceneTaa * (1 - total) + level 0.
// Level 0 ends up holding sum_k band_k * blur_k, the energy diffraction carries past 2 pixels, and
// the composite takes exactly that much from each pixel where it was.

#include "pre_exposure.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0) uniform sampler2D sourceTexture;
layout(set = 1, binding = 1, rgba16f) uniform image2D destinationImage;

// Must match BloomPushConstants in engine/renderer/vulkan/bloom_pass.cpp.
layout(push_constant) uniform BloomConstants
{
    uvec2 destinationExtent;
    vec2 sourceTexelSize;
    uint mode;
    float unused0;
    float unused1;
    float unused2;
    // Upsample: level = destination * destinationWeight + tent(source) * sourceWeight. Composite:
    // scene = scene * destinationWeight + level 0 * sourceWeight. rgb used.
    vec4 destinationWeight;
    vec4 sourceWeight;
}
bloom;

const uint MODE_FIRST_DOWNSAMPLE = 0u;
const uint MODE_DOWNSAMPLE = 1u;
const uint MODE_UPSAMPLE = 2u;
const uint MODE_COMPOSITE = 3u;

vec3 Sanitize(vec3 color)
{
    if (any(isnan(color)) || any(isinf(color)))
        return vec3(0.0);
    return clamp(color, vec3(0.0), vec3(65504.0));
}

vec3 Tap(vec2 uv, vec2 offset)
{
    return Sanitize(textureLod(sourceTexture, uv + offset * bloom.sourceTexelSize, 0.0).rgb);
}

float KarisWeight(vec3 color)
{
    // Exposed luma (1.0 = sensor saturation): Karis' weights must see what the viewer sees.
    return 1.0 / (1.0 + dot(color, vec3(0.2126, 0.7152, 0.0722)) * kExposedPerFrameBufferUnit);
}

// The 13 bilinear taps of Jimenez's downsample, grouped into five overlapping 2x2 boxes: the centre
// box weighs 0.5, the four corner boxes 0.125 each. With karis, each box is also weighted by
// 1 / (1 + its exposed luma), and the weights renormalised.
vec3 Downsample(vec2 uv, bool karis)
{
    vec3 a = Tap(uv, vec2(-2.0, -2.0));
    vec3 b = Tap(uv, vec2(0.0, -2.0));
    vec3 c = Tap(uv, vec2(2.0, -2.0));
    vec3 d = Tap(uv, vec2(-1.0, -1.0));
    vec3 e = Tap(uv, vec2(1.0, -1.0));
    vec3 f = Tap(uv, vec2(-2.0, 0.0));
    vec3 g = Tap(uv, vec2(0.0, 0.0));
    vec3 h = Tap(uv, vec2(2.0, 0.0));
    vec3 i = Tap(uv, vec2(-1.0, 1.0));
    vec3 j = Tap(uv, vec2(1.0, 1.0));
    vec3 k = Tap(uv, vec2(-2.0, 2.0));
    vec3 l = Tap(uv, vec2(0.0, 2.0));
    vec3 m = Tap(uv, vec2(2.0, 2.0));

    vec3 boxes[5] = vec3[5]((d + e + i + j) * 0.25, (a + b + f + g) * 0.25, (b + c + g + h) * 0.25, (f + g + k + l) * 0.25, (g + h + l + m) * 0.25);
    float weights[5] = float[5](0.5, 0.125, 0.125, 0.125, 0.125);
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int box = 0; box < 5; ++box)
    {
        float weight = weights[box] * (karis ? KarisWeight(boxes[box]) : 1.0);
        sum += boxes[box] * weight;
        weightSum += weight;
    }
    return sum / weightSum;
}

// 3x3 tent over the coarser level's texels: weights 1 2 1 / 2 4 2 / 1 2 1, sixteenths.
vec3 UpsampleTent(vec2 uv)
{
    vec3 sum = Tap(uv, vec2(-1.0, -1.0)) + Tap(uv, vec2(1.0, -1.0)) + Tap(uv, vec2(-1.0, 1.0)) + Tap(uv, vec2(1.0, 1.0));
    sum += 2.0 * (Tap(uv, vec2(0.0, -1.0)) + Tap(uv, vec2(-1.0, 0.0)) + Tap(uv, vec2(1.0, 0.0)) + Tap(uv, vec2(0.0, 1.0)));
    sum += 4.0 * Tap(uv, vec2(0.0));
    return sum / 16.0;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(pixel), bloom.destinationExtent)))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(bloom.destinationExtent);

    vec3 result;
    if (bloom.mode == MODE_FIRST_DOWNSAMPLE || bloom.mode == MODE_DOWNSAMPLE)
    {
        result = Downsample(uv, bloom.mode == MODE_FIRST_DOWNSAMPLE);
    }
    else if (bloom.mode == MODE_UPSAMPLE)
    {
        // Each pixel reads and writes only its own texel of this level, so the read-modify-write
        // needs no ordering between invocations.
        result = Sanitize(imageLoad(destinationImage, pixel).rgb) * bloom.destinationWeight.rgb +
                 UpsampleTent(uv) * bloom.sourceWeight.rgb;
    }
    else
    {
        vec3 scene = Sanitize(imageLoad(destinationImage, pixel).rgb);
        vec3 glow = Sanitize(textureLod(sourceTexture, uv, 0.0).rgb);
        result = scene * bloom.destinationWeight.rgb + glow * bloom.sourceWeight.rgb;
    }
    imageStore(destinationImage, pixel, vec4(Sanitize(result), 1.0));
}
