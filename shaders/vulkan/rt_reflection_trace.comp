#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

// Ray traced reflections (VulkanSsrTracePass's hardware variant, docs/design/
// 2026-10-07-ray-traced-effects-design.md): the screen-space trace's lobe and output, with the ray
// traced through the scene instead of marched against the depth buffer, so what is off screen or
// hidden is reflected too. One ray a pixel at half resolution (every pixel, with white noise, under
// DLSS ray reconstruction), drawn from the GGX visible normals of the pixel's lobe (the coat's on car
// paint, ssr_lobe.glsl). Where the hit is the surface the screen shows at that point, its colour
// comes from last frame's anti-aliased image as the screen-space trace
// takes it; elsewhere the hit is shaded here: its material from the mesh and the material's textures
// (ray_hit_common.glsl), lit by ShadeSurface with every light, the DDGI probes' ambient and a traced
// shadow ray toward the sun. A miss sees the sky. Writes SsrRaw for the SSR resolve: rgb radiance in
// HDR target units, a confidence that is the roughness fade alone.

#define RAY_TEXTURED_ALPHA
#include "scene_common.glsl"
#include "gbuffer_common.glsl"
#include "pbr_common.glsl"
#include "pre_exposure.glsl"
#include "ssr_half_res.glsl"
#include "ray_tracing_common.glsl"
#include "material_common.glsl"
#include "material_uv.glsl"
#include "ray_hit_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// VulkanSsrTracePass's set, here at set 2 (set 1 is the ray scene).
layout(set = 2, binding = 0) uniform sampler2D depthTexture;   // nearest
layout(set = 2, binding = 1) uniform sampler2D normalTexture;  // GB1, nearest
layout(set = 2, binding = 2) uniform sampler2D surfaceTexture; // GB2, nearest
layout(set = 2, binding = 3) uniform sampler2D historyTexture; // TAA history, last frame, linear
layout(set = 2, binding = 4, rgba16f) uniform writeonly image2D ssrRawImage;
layout(set = 2, binding = 5) uniform sampler2D coatTexture;     // GB6, nearest
layout(set = 2, binding = 6) uniform sampler2D velocityTexture; // .ba: a mapped coat's normal, nearest

#include "ssr_lobe.glsl"

// SsrPushConstants in engine/renderer/vulkan/ssr_pass.cpp, as ssr_trace.comp has them.
layout(push_constant) uniform SsrConstants
{
    vec2 extent;
    vec2 invExtent;
    float maxDistance;
    float maxRoughness;
    float historyScale;
    uint frameIndex;
    uint flags;
}
ssr;

// The screen's own colour stands for a hit that lies on the surface the depth buffer holds there
// within this much (plus a share of its distance).
const float SCREEN_MATCH_BASE = 0.05;
const float SCREEN_MATCH_PER_METRE = 0.01;
// How far the sun's shadow ray from a reflected point looks.
const float HIT_SHADOW_DISTANCE = 20000.0;

float InterleavedGradientNoise(vec2 pixel)
{
    return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}

// What the sky sends along a direction, as the specular environment has it at its sharpest.
vec3 SkyRadiance(vec3 direction)
{
    if (EnvironmentMode() == ENVIRONMENT_NONE)
    {
        return SceneAmbientAlong(direction);
    }
    return textureLod(prefilteredEnvironment, direction, 0.0).rgb + SceneLightsAmbientAlong(direction);
}

// The share of the shadow caster's light that reaches a reflected point: one ray at its centre.
float HitSunVisibility(vec3 position, vec3 faceNormal, uint rayId)
{
    int casterIndex = int(ubo.shadowParams.x);
    if (casterIndex < 0)
    {
        return 1.0;
    }
    vec3 toSun = normalize(-sceneLights.lights[casterIndex].directionAndType.xyz);
    if (dot(faceNormal, toSun) <= 0.0)
    {
        return 0.0;
    }
    RayHit shadowHit;
    vec3 origin = OffsetRayOrigin(position, faceNormal);
    return TraceSceneRayMasked(origin, toSun, 0.0, HIT_SHADOW_DISTANCE, true, rayId, RAY_MASK_VISIBILITY, shadowHit) ? 0.0 : 1.0;
}

void main()
{
    bool fullResolution = (ssr.flags & SSR_TRACE_FLAG_FULL_RES) != 0u;
    ivec2 rawPixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(rawPixel, fullResolution ? ivec2(ssr.extent) : SsrHalfResExtent(ivec2(ssr.extent)))))
    {
        return;
    }
    ivec2 pixel = fullResolution ? rawPixel : SsrHalfResSourcePixel(rawPixel, ssr.frameIndex, ivec2(ssr.extent));

    float depth = texelFetch(depthTexture, pixel, 0).r;
    SsrLobe lobe = ReadSsrLobe(pixel);
    float roughnessFade = SsrRoughnessFade(lobe.roughness, ssr.maxRoughness);
    if (IsFarDepth(depth) || roughnessFade <= 0.0)
    {
        imageStore(ssrRawImage, rawPixel, vec4(0.0));
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) * ssr.invExtent;
    vec4 world = ubo.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 worldPosition = world.xyz / world.w;
    vec3 N = lobe.normal;
    vec3 geoNormal = DecodeNormalOctahedral(texelFetch(normalTexture, pixel, 0).ba);
    vec3 V = normalize(ubo.cameraWorldPosition.xyz - worldPosition);

    vec2 frameOffset = vec2(float(ssr.frameIndex % 64u) * 5.588238, float(ssr.frameIndex % 64u) * 7.123);
    vec2 u = fullResolution ? SsrWhiteNoise(pixel, ssr.frameIndex)
                            : vec2(InterleavedGradientNoise(vec2(pixel) + frameOffset), InterleavedGradientNoise(vec2(pixel.yx) + frameOffset * 1.37));
    vec3 H = SampleGgxVisibleNormal(N, V, lobe.roughness, u);
    vec3 R = reflect(-V, H);
    if (dot(R, N) <= 0.0 || dot(R, geoNormal) <= 0.0)
    {
        imageStore(ssrRawImage, rawPixel, vec4(0.0));
        return;
    }

    float distanceToCamera = length(ubo.cameraWorldPosition.xyz - worldPosition);
    vec3 origin = OffsetRayOrigin(worldPosition + geoNormal * (0.002 + 0.0004 * distanceToCamera), geoNormal);
    uint rayId = uint(pixel.x) * 73856093u ^ uint(pixel.y) * 19349663u ^ ssr.frameIndex * 83492791u;
    RayHit hit;
    vec3 radiance;
    if (!TraceSceneRayMasked(origin, R, 0.0, ssr.maxDistance, false, rayId, RAY_MASK_VISIBILITY, hit))
    {
        radiance = SkyRadiance(R) * ubo.exposure.x;
    }
    else
    {
        RayHitSurface surface = RayHitSurfaceOf(hit, origin, R);
        bool shaded = true;

        // Where the screen shows this very point, last frame's anti-aliased image already holds its
        // colour with every effect on it.
        vec4 clip = ubo.proj * ubo.view * vec4(surface.position, 1.0);
        if (clip.w > 0.0)
        {
            vec2 hitUv = clip.xy / clip.w * 0.5 + 0.5;
            if (all(greaterThanEqual(hitUv, vec2(0.0))) && all(lessThanEqual(hitUv, vec2(1.0))))
            {
                ivec2 hitPixel = clamp(ivec2(hitUv * ssr.extent), ivec2(0), ivec2(ssr.extent) - 1);
                float sceneDepth = texelFetch(depthTexture, hitPixel, 0).r;
                float hitDistance = clip.w;
                float sceneDistance = ubo.proj[3][2] / (sceneDepth + ubo.proj[2][2]);
                vec4 previousClip = ubo.prevViewProj * vec4(surface.position, 1.0);
                vec2 previousUv = previousClip.xy / previousClip.w * 0.5 + 0.5;
                if (!IsFarDepth(sceneDepth) && abs(sceneDistance - hitDistance) < SCREEN_MATCH_BASE + SCREEN_MATCH_PER_METRE * hitDistance &&
                    previousClip.w > 0.0 && all(greaterThanEqual(previousUv, vec2(0.0))) && all(lessThanEqual(previousUv, vec2(1.0))))
                {
                    radiance = textureLod(historyTexture, previousUv, 0.0).rgb * ssr.historyScale;
                    shaded = false;
                }
            }
        }

        if (shaded)
        {
            RayMaterial rayMaterial = rayMaterials[rayInstances[hit.instance].data.z];
            bool doubleSided = (floatBitsToUint(rayMaterial.emissionFlags.w) & RAY_MATERIAL_DOUBLE_SIDED) != 0u;
            if (!hit.frontFace && !doubleSided)
            {
                // The inside of a closed mesh: dark.
                radiance = vec3(0.0);
            }
            else
            {
                // The ray cone's width at the hit: a pixel's footprint where the ray left, widened by
                // a pixel's angle and the lobe's spread over the ray's length.
                float pixelAngle = 2.0 / (abs(ubo.proj[1][1]) * ssr.extent.y);
                float footprint = (distanceToCamera + hit.t) * pixelAngle + hit.t * lobe.roughness * lobe.roughness;
                RayHitShading material = RayHitShadingOf(surface, footprint, abs(dot(surface.normal, R)));
                if ((material.flags & SHADING_FLAG_UNLIT) != 0u)
                {
                    radiance = material.albedo * kFrameBufferUnitsPerExposed;
                }
                else
                {
                    // The cluster grid covers the view frustum only: a point outside it loops over
                    // every local light.
                    vec3 ndc = clip.xyz / max(clip.w, 1e-6);
                    shadeAllLocalLights = clip.w <= 0.0 || any(greaterThan(abs(ndc.xy), vec2(1.0)));
                    tracedSunShadow = HitSunVisibility(OffsetRayOrigin(surface.position, surface.faceNormal), surface.faceNormal, rayId ^ 0x5bd1e995u);
                    vec3 color = ShadeSurface(
                        surface.position, surface.normal, surface.faceNormal, -R,
                        material.albedo, material.metallic, material.roughness, 1.0, material.emissive,
                        NoCoat(), NoSheen(), NoAnisotropy(), NoSpecularOverride(), vec4(0.0));
                    radiance = color * ubo.exposure.x;
                }
            }
        }
    }
    if (any(isnan(radiance)) || any(isinf(radiance)))
    {
        radiance = vec3(0.0);
    }
    imageStore(ssrRawImage, rawPixel, vec4(min(radiance, vec3(65504.0)), roughnessFade));
}
