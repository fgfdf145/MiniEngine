#version 450
#extension GL_GOOGLE_include_directive : require

#include "scene_common.glsl"
#include "atmosphere_sampling.glsl"
#include "volumetric_clouds.glsl"
#include "cloud_reconstruction.glsl"

// The clouds at the scene's extent, every frame after cloud_march.comp
// (VulkanAtmosphere::RecordClouds; cloud_reconstruction.glsl). The pixel this frame marched takes
// its sample, blended with its history; the others take last frame's clouds reprojected, held to
// the range of this frame's samples around them, so a moving view leaves no trail. Without a
// history (the first frame, a resize) every pixel interpolates this frame's samples. The sky pass
// composites the result; the RecordClouds copy makes it next frame's history.
layout(local_size_x = 8, local_size_y = 8) in;

// Set 1 bindings 11-13 of the atmosphere's compute set.
layout(set = 1, binding = 11, rgba16f) uniform readonly image2D cloudSamples;
layout(set = 1, binding = 12, rgba16f) uniform writeonly image2D cloudResolvedOut;
layout(set = 1, binding = 13) uniform sampler2D cloudHistory;

// A freshly marched pixel keeps this much of its own sample over its history, which averages the
// march's jitter over the frames before TAA does.
const float CLOUD_FRESH_WEIGHT = 0.5;
// The others lean toward this frame's interpolated samples by this much per pixel the clouds moved,
// up to the most: the reprojection takes one distance per ray, so a fast-moving camera's parallax
// lands a little off, and pixels refreshed on different frames would comb the edges.
const float CLOUD_MOTION_WEIGHT_PER_PIXEL = 0.125;
const float CLOUD_MAX_MOTION_WEIGHT = 0.5;

vec4 MarchedSample(ivec2 texel)
{
    return imageLoad(cloudSamples, clamp(texel, ivec2(0), imageSize(cloudSamples) - 1));
}

// Catmull-Rom over the history in five bilinear taps, as taa_resolve.comp: a moving view resamples
// the history every frame, and bilinear would blur it a little more each time.
vec4 SampleHistory(vec2 uv, vec2 extent)
{
    vec2 samplePosition = uv * extent;
    vec2 center = floor(samplePosition - 0.5) + 0.5;
    vec2 f = samplePosition - center;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 position0 = (center - 1.0) / extent;
    vec2 position3 = (center + 2.0) / extent;
    vec2 position12 = (center + w2 / w12) / extent;

    vec4 result = textureLod(cloudHistory, vec2(position12.x, position0.y), 0.0) * (w12.x * w0.y);
    result += textureLod(cloudHistory, vec2(position0.x, position12.y), 0.0) * (w0.x * w12.y);
    result += textureLod(cloudHistory, position12, 0.0) * (w12.x * w12.y);
    result += textureLod(cloudHistory, vec2(position3.x, position12.y), 0.0) * (w3.x * w12.y);
    result += textureLod(cloudHistory, vec2(position12.x, position3.y), 0.0) * (w12.x * w3.y);
    float weight = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    // The negative lobes can ring below zero at hard edges; the box below bounds the rest.
    return max(result / weight, vec4(0.0));
}

// How far the clouds along direction lie from the camera, km, to reproject them: the middle of the
// first stretch of the layer the ray crosses, as the march lights them; far when it misses.
float CloudDistanceKm(vec3 direction)
{
    vec3 camera = ubo.atmosphereCameraPositionKm.xyz;
    float inner = BottomRadius() + ubo.cloudLayer.x;
    float thickness = ubo.cloudLayer.y;
    vec2 span = CloudShellInterval(camera, direction, BottomRadius(), inner, inner + thickness, CLOUD_MAX_DISTANCE_KM);
    return span.y > span.x ? span.x + min(span.y - span.x, thickness) * 0.5 : CLOUD_MAX_DISTANCE_KM;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = CloudSceneExtent();
    if (any(greaterThanEqual(pixel, extent)))
    {
        return;
    }

    // This frame's samples sit at 2 t + marched: the pixel in sample units, and the 3 x 3 samples
    // around the nearest, which hold the bilinear four.
    ivec2 marched = CloudMarchedPixelInBlock();
    vec2 position = vec2(pixel - marched) * 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = position - vec2(base);
    ivec2 nearest = base + ivec2(greaterThanEqual(f, vec2(0.5)));
    vec4 samples[9];
    vec4 low = vec4(65504.0);
    vec4 high = vec4(0.0);
    for (int y = 0; y < 3; ++y)
    {
        for (int x = 0; x < 3; ++x)
        {
            vec4 marchedSample = MarchedSample(nearest + ivec2(x - 1, y - 1));
            samples[y * 3 + x] = marchedSample;
            low = min(low, marchedSample);
            high = max(high, marchedSample);
        }
    }
    ivec2 corner = base - nearest + ivec2(1);
    vec4 s00 = samples[corner.y * 3 + corner.x];
    vec4 s10 = samples[corner.y * 3 + min(corner.x + 1, 2)];
    vec4 s01 = samples[min(corner.y + 1, 2) * 3 + corner.x];
    vec4 s11 = samples[min(corner.y + 1, 2) * 3 + min(corner.x + 1, 2)];
    vec4 current = mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
    bool fresh = all(equal(pixel & 1, marched));

    vec4 result = current;
    if (CloudHistoryValid())
    {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
        vec3 direction = ViewDirectionFromTexCoord(uv + CloudJitterUv());
        vec3 world = ubo.cameraWorldPosition.xyz + direction * (CloudDistanceKm(direction) * 1000.0);
        // The wind carried the clouds here: last frame they stood upwind by this frame's step.
        vec3 previousWorld = world - vec3(ubo.cloudMotionStep.x, 0.0, ubo.cloudMotionStep.y);
        vec4 previousClip = ubo.prevViewProj * vec4(previousWorld, 1.0);
        vec2 previousUv = previousClip.xy / previousClip.w * 0.5 + 0.5;
        if (previousClip.w > 0.0 && all(greaterThanEqual(previousUv, vec2(0.0))) && all(lessThanEqual(previousUv, vec2(1.0))))
        {
            vec4 history = clamp(SampleHistory(previousUv, vec2(extent)), low, high);
            float motionPixels = length((uv - previousUv) * vec2(extent));
            float weight = fresh ? CLOUD_FRESH_WEIGHT : min(motionPixels * CLOUD_MOTION_WEIGHT_PER_PIXEL, CLOUD_MAX_MOTION_WEIGHT);
            result = mix(history, current, weight);
        }
    }
    imageStore(cloudResolvedOut, pixel, result);
}
