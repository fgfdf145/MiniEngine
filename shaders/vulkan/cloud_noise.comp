#version 450

// The volumetric clouds' two tiling billow volumes, built once (VulkanAtmosphere::Record)
// (docs/design/2026-10-06-cumulus-generation-design.md). Every channel is one octave of sphere
// packing: around one jittered point per cell, sqrt(1 - d^2) of the distance d to the nearest in
// cells, so a channel is a union of round lobes with creases where they meet - the cauliflower of
// a cumulus. Each is stretched from its 0.45 floor onto [0, 1], where its mean is 0.69
// (kCloudBillowMean); the clouds add every octave about that mean, scaled to its sphere size.
//   shape  128^3: r g b 4, 8 and 16 spheres per tile, a 1;
//   detail 128^3: r g b a 2, 4, 8 and 16 spheres per tile.
// Every octave wraps at the tile edge, so the REPEAT sampler shows no seam.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Set 1 bindings 7 and 8 of the atmosphere's compute set.
layout(set = 1, binding = 7, rgba8) uniform writeonly image3D shapeNoiseOut;
layout(set = 1, binding = 8, rgba8) uniform writeonly image3D detailNoiseOut;

// Must match kCloudNoiseSizes in engine/renderer/vulkan/atmosphere.cpp.
const int SHAPE_SIZE = 128;
const int DETAIL_SIZE = 128;

uvec3 Hash3(uvec3 v)
{
    // Jarzynski and Olano 2020, pcg3d.
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}

vec3 Random3(ivec3 cell, uint seed)
{
    return vec3(Hash3(uvec3(cell) + uvec3(seed, seed * 7u, seed * 13u)) & 0xffffu) / 65535.0;
}

// One octave of sphere packing over period cells per unit of p in [0, 1), in [0, 1].
float SphereBillow(vec3 p, float period, uint seed)
{
    vec3 scaled = p * period;
    ivec3 cell = ivec3(floor(scaled));
    vec3 local = fract(scaled);
    int wrap = int(period);
    float nearest = 1.0;
    for (int z = -1; z <= 1; ++z)
    {
        for (int y = -1; y <= 1; ++y)
        {
            for (int x = -1; x <= 1; ++x)
            {
                ivec3 offset = ivec3(x, y, z);
                ivec3 wrapped = (cell + offset + wrap) % wrap;
                vec3 feature = vec3(offset) + Random3(wrapped, seed);
                nearest = min(nearest, length(feature - local));
            }
        }
    }
    float sphere = sqrt(max(1.0 - nearest * nearest, 0.0));
    return clamp((sphere - 0.45) / 0.55, 0.0, 1.0);
}

void main()
{
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(texel, ivec3(SHAPE_SIZE))))
    {
        return;
    }
    vec3 p = (vec3(texel) + 0.5) / float(SHAPE_SIZE);
    imageStore(shapeNoiseOut, texel, vec4(SphereBillow(p, 4.0, 11u), SphereBillow(p, 8.0, 23u), SphereBillow(p, 16.0, 37u), 1.0));
    if (all(lessThan(texel, ivec3(DETAIL_SIZE))))
    {
        vec3 q = (vec3(texel) + 0.5) / float(DETAIL_SIZE);
        imageStore(detailNoiseOut, texel,
                   vec4(SphereBillow(q, 2.0, 51u), SphereBillow(q, 4.0, 67u), SphereBillow(q, 8.0, 79u), SphereBillow(q, 16.0, 97u)));
    }
}
