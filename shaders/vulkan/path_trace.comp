#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

// The path tracer's trace (VulkanPathTracePass, docs/design/2026-10-07-path-tracing-design.md): the
// indirect light at every opaque deferred pixel, from the G-buffer's surface, through the ray scene
// with hardware ray queries. Two paths a pixel, one leaving through the diffuse lobe and one through a
// specular lobe (the base's or the coat's, picked by their albedos), so both channels the denoiser
// filters get a sample every frame. At each surface a path visits:
//   - what it emits, and what the sky sends where it leaves the scene (the prefiltered environment's
//     sharpest level, which holds the clouds but not the sun's disk, plus the Ambient and Hemisphere
//     lights);
//   - next event estimation: every directional light (a disk the sun's size) and one local light
//     resampled from a few candidates (the light grid's cell, else the cluster grid's list where the
//     point is in the view frustum), each through a shadow ray; the analytic lights are invisible to
//     the paths themselves, so nothing is counted twice. And at the G-buffer's surface and the first
//     path vertex, one point on an emissive triangle picked by power (emissive_lights_common.glsl),
//     weighed against the paths that hit it by multiple importance sampling;
//   - the next direction from its material's diffuse or GGX lobe (visible normals), with Russian
//     roulette from the third surface on.
// The direct light at the G-buffer's surface itself is the lighting pass's, so a path starts with
// its first bounce. The result is divided by the lobe's albedo (PathTraceLobesOf) and pre-exposed.
// Materials at a path's later surfaces have their coat, sheen and dielectric specular from the factors
// alone (RayHitLayersOf), and their normal maps where the path is a mirror-like reflection; no blend
// graph, detail layers or anisotropy.
// Every ray passes through the air and the height fog (RayMedium).

#define RAY_TEXTURED_ALPHA
#define PATH_TRACE_SET 2
// The variants (VulkanPathTracePass picks one per frame): PT_TRANSMISSION 0 leaves out what the
// paths do at transmissive surfaces (no forward surfaces: they meet none but by coverage, as opaque),
// PT_LAYERED 0 the later surfaces' coat, sheen, dielectric specular and normal maps (no material in
// the ray scene has any). The code they leave out folds away at compile time, and with it the
// registers it held.
#ifndef PT_TRANSMISSION
#define PT_TRANSMISSION 1
#endif
#ifndef PT_LAYERED
#define PT_LAYERED 1
#endif
#include "scene_common.glsl"
#include "gbuffer_common.glsl"
#include "pbr_common.glsl"
#include "atmosphere_integrate.glsl"
#include "pre_exposure.glsl"
#include "path_trace_common.glsl"
#include "ray_tracing_common.glsl"
#include "material_common.glsl"
#include "material_uv.glsl"
#include "ray_hit_common.glsl"
#define EMISSIVE_LIGHT_SET 4
#include "emissive_lights_common.glsl"
#include "light_grid_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// How far a path's rays look, and its shadow rays toward the sun: past every map the engine loads.
const float PT_MAX_DISTANCE = 20000.0;
// How wide a lobe spreads a ray cone, radians, for the texture level of detail: a diffuse bounce
// blurs whatever it finds; a specular one by its roughness.
const float PT_DIFFUSE_SPREAD = 0.3;
// Path regularization (Kaplanyan and Dachsbacher 2013, in its simple form): a surface a path reaches
// after a diffuse bounce is at least this rough, so a lamp's light reflected off a near-mirror onto a
// diffuse surface (a caustic, which next event estimation finds only by luck) is a soft glow rather
// than scattered speckles. Off with the firefly clamp, for the reference.
const float PT_REGULARIZED_ROUGHNESS = 0.3;
// The roughest a lobe may be for its path to count as a sharp reflection.
const float PT_SHARP_ROUGHNESS = 0.3;
// Rays through less air than this (kilometres, at the scene's aerial perspective distance scale) pass
// it untouched: a clear sky takes out under 4 % per kilometre near the ground, so under 1 % here.
const float PT_AIR_MIN_KM = 0.2;
// Emissive samples whose light would add less than this (pre-exposed luminance) trace their shadow
// ray by Russian roulette (EmissiveShadowWeight).
const float PT_SHADOW_ROULETTE = 1.0 / 64.0;
// The path vertices next event estimation looks for an emissive triangle at, from the first: past
// them the paths alone find emissive surfaces (all their light, no MIS), which costs a shadow ray less
// a vertex where it matters least.
const uint PT_EMISSIVE_NEE_BOUNCES = 1u;
// The hit distance a ray that leaves the scene reports to ray reconstruction: far enough that its
// reflection moves with the camera's rotation alone.
const float PT_SKY_HIT_DISTANCE = 10000.0;
// The most interfaces a path leaves transmissive volumes through.
const uint PT_MAX_VOLUME_EXITS = 4u;

uint g_rngState;
// How far the last TracePath's first ray went before it met a surface (PT_SKY_HIT_DISTANCE when it
// left the scene).
float g_firstHitDistance = 0.0;

float Random()
{
    // PCG (O'Neill 2014), the RXS-M-XS output.
    g_rngState = g_rngState * 747796405u + 2891336453u;
    uint word = ((g_rngState >> ((g_rngState >> 28u) + 4u)) ^ g_rngState) * 277803737u;
    word = (word >> 22u) ^ word;
    return float(word >> 8u) * (1.0 / 16777216.0);
}

uint HashUint(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

// A ray id for the coverage decisions of partly covered surfaces: a different one every ray.
uint NextRayId()
{
    return HashUint(g_rngState ^ 0x9e3779b9u);
}

vec3 CosineSampleHemisphere(vec3 N, vec2 u)
{
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);
    float r = sqrt(u.x);
    float phi = 2.0 * PI * u.y;
    return normalize(T * (r * cos(phi)) + B * (r * sin(phi)) + N * sqrt(max(1.0 - u.x, 0.0)));
}

// Smith's G2 / G1(V) for the height-correlated GGX lobe of this alpha: the weight of a direction
// drawn from its visible normals, F aside.
float SmithG2OverG1(float NdV, float NdL, float alpha)
{
    float a2 = alpha * alpha;
    float lambdaV = 0.5 * (-1.0 + sqrt(1.0 + a2 * (1.0 - NdV * NdV) / max(NdV * NdV, 1e-8)));
    float lambdaL = 0.5 * (-1.0 + sqrt(1.0 + a2 * (1.0 - NdL * NdL) / max(NdL * NdL, 1e-8)));
    return (1.0 + lambdaV) / (1.0 + lambdaV + lambdaL);
}

// The probability density (solid angle) of a GGX lobe's visible normals reflecting V into L: G1(V)
// D(H) / (4 N.V), as SampleGgxVisibleNormal draws them.
float GgxReflectionDensity(vec3 N, vec3 V, vec3 L, float roughness)
{
    if (dot(N, L) <= 0.0)
    {
        return 0.0;
    }
    float NdV = max(dot(N, V), 1e-4);
    float alpha = roughness * roughness;
    float lambdaV = 0.5 * (-1.0 + sqrt(1.0 + alpha * alpha * (1.0 - NdV * NdV) / (NdV * NdV)));
    return DistributionGGX(N, normalize(V + L), roughness) / (4.0 * NdV * (1.0 + lambdaV));
}

// The power heuristic's weight of the strategy whose density is chosen, against the other's.
float MisWeight(float chosen, float other)
{
    float chosen2 = chosen * chosen;
    float total = chosen2 + other * other;
    return total > 0.0 && !isinf(total) ? chosen2 / total : (chosen >= other ? 1.0 : 0.0);
}

bool EmissiveLightsOn()
{
    return (pathTrace.flags & PT_FLAG_EMISSIVE_LIGHTS) != 0u;
}

// The density next event estimation picks the direction to a path's hit with, solid angle: its
// triangle's probability over its area, by the squared distance over the cosine there. 0 for a hit
// that is no emissive light.
float EmissiveHitDensity(RayHit hit, vec3 faceNormal, vec3 direction)
{
    uint light = EmissiveLightOfHit(hit);
    if (light == ~0u)
    {
        return 0.0;
    }
    EmissiveTriangle triangle = emissiveTriangles[light];
    float area = 0.5 * length(cross(triangle.e1Slot.xyz, triangle.e2Front.xyz));
    float cosine = abs(dot(direction, faceNormal));
    return area > 0.0 && cosine > 0.0 ? EmissiveLightProbability(light) * hit.t * hit.t / (area * cosine) : 0.0;
}

// One point on an emissive triangle, picked by the power tree, seen from position past faceNormal's
// side, unshadowed: false when there is none to see (picked nothing, or behind the surface or the
// light). light is the radiance it sends along L, over the density of picking it (solid angle), which
// is in density; target is where its shadow ray ends, short of the point by a few units of rounding
// of its coordinates over the cosine there: a ray stopped a fixed distance short ran within rounding
// of the light's plane where it met the light at a grazing angle, and hit the light itself; lifting
// the point off the plane instead (OffsetRayOrigin, several centimetres this far from the origin)
// took it through the near side of a thin light (a neon tube) to its far side.
bool EmissiveSample(vec3 position, vec3 faceNormal, float footprintWidth, out vec3 L, out vec3 light, out float density, out vec3 target)
{
    L = vec3(0.0, 0.0, 1.0);
    light = vec3(0.0);
    density = 0.0;
    target = position;
    uint picked;
    if (!PickEmissiveLight(Random(), picked))
    {
        return false;
    }
    EmissivePoint point;
    if (!SampleEmissivePoint(picked, vec2(Random(), Random()), position, footprintWidth, point))
    {
        return false;
    }
    vec3 toLight = point.position - position;
    float distance2 = dot(toLight, toLight);
    L = toLight / max(sqrt(distance2), 1e-6);
    float cosLight = -dot(point.normal, L);
    if (dot(L, faceNormal) <= 0.0 || cosLight <= 0.0 || all(equal(point.radiance, vec3(0.0))))
    {
        return false;
    }
    density = point.areaDensity * distance2 / cosLight;
    light = point.radiance / density;
    vec3 magnitude = abs(point.position);
    float margin = (1e-3 + 4e-7 * max(magnitude.x, max(magnitude.y, magnitude.z))) / max(cosLight, 0.01);
    target = point.position - L * min(margin, 0.5 * sqrt(distance2));
    return true;
}

// The weight of an emissive sample's shadow ray, with Russian roulette by what it would add (its
// pre-exposed luminance, contribution): one that adds less than PT_SHADOW_ROULETTE is traced only
// with that share of probability and counts for one over it, so the many dim samples (a far sign,
// light at a grazing angle) cost few rays; then 0 when the scene's casters shadow the way to target.
float EmissiveShadowWeight(vec3 position, vec3 faceNormal, vec3 target, float contribution)
{
    float weight = 1.0;
    float luminance = contribution * ubo.exposure.x;
    if (luminance < PT_SHADOW_ROULETTE)
    {
        float survival = luminance / PT_SHADOW_ROULETTE;
        if (!(Random() < survival))
        {
            return 0.0;
        }
        weight = 1.0 / survival;
    }
    vec3 origin = OffsetRayOrigin(position, faceNormal);
    vec3 toTarget = target - origin;
    float reach = length(toTarget);
    RayHit hit;
    return reach > 0.0 && TraceSceneRayMasked(origin, toTarget / reach, 0.0, reach, true, NextRayId(), RAY_MASK_SHADOW, hit) ? 0.0 : weight;
}

// What the layered surface (ShadeSurface's composition, as LayeredLight) reflects toward V of light
// arriving along L.
vec3 LayeredReflection(
    vec3 N, vec3 V, vec3 L, vec3 light, vec3 albedo, float metallic, float roughness, vec3 energyCompensation, CoatParams coat,
    SheenParams sheen, SpecularParams specular, float sheenScaling, float coatTransmittance)
{
    vec3 result = EvaluateBRDF(N, V, L, L, 1.0, albedo, metallic, roughness, NoAnisotropy(), specular, energyCompensation, light);
    if (HasSheen(sheen))
    {
        result = result * sheenScaling + EvaluateSheen(N, V, L, sheen, light);
    }
    if (coat.factor > 0.0)
    {
        result = result * coatTransmittance + coat.factor * EvaluateCoatSpecular(coat, V, L, 1.0, light);
    }
    return result;
}

// The density (solid angle) of a path vertex's next direction being L, its lobes picked by their
// weights (x diffuse, y the base's specular, z the coat, w all of them with the transmission, which
// never leaves on L's side).
float PathVertexDensity(vec3 N, vec3 coatNormal, vec3 V, vec3 L, float roughness, float coatRoughness, vec4 lobeWeights)
{
    if (lobeWeights.w <= 0.0)
    {
        return 0.0;
    }
    float density = lobeWeights.x * max(dot(N, L), 0.0) / PI;
    if (lobeWeights.y > 0.0)
    {
        density += lobeWeights.y * GgxReflectionDensity(N, V, L, roughness);
    }
    if (lobeWeights.z > 0.0)
    {
        density += lobeWeights.z * GgxReflectionDensity(coatNormal, V, L, coatRoughness);
    }
    return density / lobeWeights.w;
}

// What the sky sends along a direction, as the reflections see it.
vec3 SkyRadiance(vec3 direction)
{
    if (EnvironmentMode() == ENVIRONMENT_NONE)
    {
        return SceneAmbientAlong(direction);
    }
    return textureLod(prefilteredEnvironment, direction, 0.0).rgb + SceneLightsAmbientAlong(direction);
}

// What the air and the height fog do to the light along one of a path's rays, as the lighting pass
// hazes the G-buffer's surface (ApplyAerialPerspective, the fog over the air) but for a ray from
// anywhere: the share of the light from its far end that arrives, and the light they scatter toward
// its start. The air is integrated along the ray itself (Hillaire's march, as the aerial perspective
// volume is built, a step every half kilometre); a ray that leaves the scene brings the sky's light,
// which holds the air already, so it only meets the fog, all the way out.
struct PathMedium
{
    vec3 transmittance;
    vec3 inscatter;
};

PathMedium RayMedium(vec3 origin, vec3 direction, float distance, bool toSky)
{
    PathMedium medium;
    medium.transmittance = vec3(1.0);
    medium.inscatter = vec3(0.0);
    if ((pathTrace.flags & PT_FLAG_RAY_MEDIA) == 0u)
    {
        return medium;
    }
    if (!toSky && EnvironmentMode() == ENVIRONMENT_ATMOSPHERE)
    {
        float kilometresPerUnit = 0.001 * ubo.atmosphereRadii.z;
        float lengthKm = distance * kilometresPerUnit;
        if (lengthKm > PT_AIR_MIN_KM)
        {
            vec3 startKm = ubo.atmosphereCameraPositionKm.xyz + (origin - ubo.cameraWorldPosition.xyz) * kilometresPerUnit;
            ScatteringResult air = IntegrateScatteredLuminance(
                startKm, direction, ubo.sunDirectionAndMode.xyz, ubo.sunIlluminance.rgb, atmosphereTransmittanceLut, ptMultiScatteringLut,
                false, clamp(ceil(lengthKm * 2.0), 1.0, 8.0), lengthKm, true, true);
            medium.transmittance = air.transmittance;
            medium.inscatter = air.luminance;
        }
    }
    if (ubo.heightFogDensity.x > 0.0)
    {
        // HeightFogOpticalDepth from the ray's own start, which has no start distance.
        float falloff = ubo.heightFogDensity.y;
        float startExponent = -(origin.y - ubo.heightFogDensity.z) * falloff;
        float opticalDepth;
        if (toSky)
        {
            float climb = falloff * direction.y;
            opticalDepth = climb <= 1e-6 ? 1e30 : ubo.heightFogDensity.x * exp(min(startExponent, HEIGHT_FOG_MAX_EXPONENT)) / climb;
        }
        else
        {
            float kL = falloff * direction.y * distance;
            opticalDepth = ubo.heightFogDensity.x * exp(min(startExponent + max(-kL, 0.0), HEIGHT_FOG_MAX_EXPONENT)) * distance *
                           HeightFogSegmentAverage(abs(kL));
        }
        float opacity = min(1.0 - exp(-opticalDepth), ubo.heightFogColor.w);
        medium.transmittance *= 1.0 - opacity;
        medium.inscatter = mix(medium.inscatter, HeightFogInscatter(direction), opacity);
    }
    return medium;
}

// KHR_materials_transmission at a path's surface, from its material's factors (maps left out):
// the share of the diffuse that passes through, whether the surface bounds a volume (a thickness, and
// a closed mesh: a double-sided one is a thin wall either way), its IOR, and for a ray that has just
// crossed the volume to the hit, the light its medium let through on the way (Beer-Lambert in the
// attenuation colour per attenuation distance, mesh units taken as world units).
struct TransmissionLobe
{
    float factor;
    bool volume;
    float ior;
    vec3 absorption;
};

TransmissionLobe TransmissionLobeOf(RayHit hit, bool transmissive, bool doubleSided)
{
    TransmissionLobe lobe;
    lobe.factor = 0.0;
    lobe.volume = false;
    lobe.ior = 1.5;
    lobe.absorption = vec3(1.0);
    if (PT_TRANSMISSION == 0 || !transmissive)
    {
        return lobe;
    }
    MaterialData material = materialData.materials[rayInstances[hit.instance].data.z];
    lobe.factor = clamp(material.transmissionFactors.x, 0.0, 1.0);
    lobe.volume = material.transmissionFactors.y > 0.0 && !doubleSided;
    lobe.ior = max(material.attenuationColor.a, 1.0);
    float attenuationDistance = material.transmissionFactors.z;
    if (lobe.volume && attenuationDistance > 0.0)
    {
        lobe.absorption = pow(clamp(material.attenuationColor.rgb, vec3(1e-4), vec3(1.0)), vec3(hit.t / attenuationDistance));
    }
    return lobe;
}

// The roughness floor after a diffuse bounce: none for the reference.
float Regularization()
{
    return pathTrace.fireflyClamp > 0.0 ? PT_REGULARIZED_ROUGHNESS : 0.0;
}

// A vertex's contribution with its pre-exposed luminance held to the firefly clamp.
vec3 ClampContribution(vec3 contribution)
{
    if (pathTrace.fireflyClamp <= 0.0)
    {
        return contribution;
    }
    float luminance = PathTraceLuminance(contribution) * ubo.exposure.x;
    return luminance > pathTrace.fireflyClamp ? contribution * (pathTrace.fireflyClamp / luminance) : contribution;
}

// One shadow ray toward a point within a directional light's disk (the sun's size).
float DirectionalVisibility(vec3 origin, vec3 toLight)
{
    float cosRadius = clamp(ubo.sunIlluminance.w, 0.99, 1.0);
    float cosTheta = mix(1.0, cosRadius, Random());
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 helper = abs(toLight.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(helper, toLight));
    vec3 bitangent = cross(toLight, tangent);
    float phi = 2.0 * PI * Random();
    vec3 direction = normalize(toLight * cosTheta + (tangent * cos(phi) + bitangent * sin(phi)) * sinTheta);
    RayHit hit;
    return TraceSceneRayMasked(origin, direction, 0.0, PT_MAX_DISTANCE, true, NextRayId(), RAY_MASK_SHADOW, hit) ? 0.0 : 1.0;
}

// One shadow ray toward a point on a local light's source, as the lighting pass traces them
// (deferred_lighting.frag's TraceLocalLightShadow): its sphere seen from the surface, or its rectangle.
float LocalVisibility(SceneLightData light, vec3 position, vec3 faceNormal)
{
    vec3 target = light.positionAndRange.xyz;
    vec2 u = vec2(Random(), Random());
    if (int(light.directionAndType.w) == LIGHT_AREA)
    {
        vec3 lightNormal = normalize(light.directionAndType.xyz);
        vec3 rightAxis = normalize(light.areaRightAxis.xyz);
        vec3 upAxis = cross(lightNormal, rightAxis);
        target += rightAxis * ((u.x - 0.5) * light.spotAndArea.z) + upAxis * ((u.y - 0.5) * light.spotAndArea.w);
    }
    else if (light.spotAndArea.z > 0.0)
    {
        vec3 axis = normalize(position - target);
        vec3 helper = abs(axis.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(helper, axis));
        vec3 bitangent = cross(axis, tangent);
        float radius = light.spotAndArea.z * sqrt(u.x);
        float phi = 2.0 * PI * u.y;
        target += (tangent * cos(phi) + bitangent * sin(phi)) * radius;
    }
    vec3 toTarget = target - position;
    vec3 offsetNormal = dot(faceNormal, toTarget) >= 0.0 ? faceNormal : -faceNormal;
    vec3 origin = OffsetRayOrigin(position, offsetNormal);
    toTarget = target - origin;
    float distance = length(toTarget);
    float reach = distance - kLocalShadowNearPlaneMetres;
    if (reach <= 0.0)
    {
        return 1.0;
    }
    RayHit hit;
    return TraceSceneRayMasked(origin, toTarget / distance, 0.0, reach, true, NextRayId(), RAY_MASK_SHADOW, hit) ? 0.0 : 1.0;
}

// The hit's coat, sheen and dielectric specular from its material's factors alone (their maps left
// out), as EvaluateMaterialLayers makes them: the coat on the interpolated vertex normal.
void RayHitLayersOf(RayHitSurface surface, out CoatParams coat, out SheenParams sheen, out SpecularParams specular)
{
    MaterialData material = materialData.materials[surface.drawSlot];
    uint flags = material.shadingModel.x;
    coat = NoCoat();
    sheen = NoSheen();
    specular = NoSpecularOverride();
    if (PT_LAYERED == 0)
    {
        return;
    }
    if ((flags & SHADING_FLAG_CLEARCOAT) != 0u)
    {
        coat.factor = clamp(material.clearcoatFactors.x, 0.0, 1.0);
        coat.roughness = clamp(material.clearcoatFactors.y, 0.04, 1.0);
        coat.normal = surface.normal;
    }
    if ((flags & SHADING_FLAG_SHEEN) != 0u)
    {
        sheen.color = clamp(material.sheenFactors.rgb, 0.0, 1.0);
        sheen.roughness = clamp(material.sheenFactors.a, 0.04, 1.0);
    }
    if ((flags & SHADING_FLAG_SPECULAR) != 0u)
    {
        float factor = clamp(material.specularFactors.a, 0.0, 1.0);
        specular.dielectricF0 = min(material.specularFactors.rgb, vec3(1.0)) * factor;
        specular.dielectricF90 = factor;
    }
}

// The light one scene light sends toward V off a path's surface, unshadowed, its layers composed as
// ShadeSurface composes them: the base under the sheen's scaling, plus the sheen; all of it under
// what the coat's Fresnel lets through, plus the coat.
vec3 LayeredLight(
    SceneLightData light, vec3 position, vec3 N, vec3 V, vec3 albedo, float metallic, float roughness, vec3 energyCompensation,
    CoatParams coat, SheenParams sheen, SpecularParams specular, float sheenScaling, float coatTransmittance)
{
    vec3 coatContribution;
    vec3 sheenContribution;
    vec3 result = EvaluateSceneLight(
        light, position, N, V, albedo, metallic, roughness, energyCompensation, coat, coatContribution, sheen, sheenContribution,
        NoAnisotropy(), specular);
    if (HasSheen(sheen))
    {
        result = result * sheenScaling + sheenContribution;
    }
    if (coat.factor > 0.0)
    {
        result = result * coatTransmittance + coat.factor * coatContribution;
    }
    return result;
}

// Next event estimation at a path's surface: the light every directional light and one resampled
// local light send toward V, shadowed by a ray each. The local light is resampled importance
// sampling (Talbot 2005) over lightCandidates uniform picks, with the luminance of the base layer's
// unshadowed contribution as the target (the coat and the sheen are evaluated for the chosen light
// alone): from the light grid's cell when the point is in it (light_grid_common.glsl: lights whose
// range reaches the cell, a uniform subset of them when there are more than it holds, each then
// counting for all of them), else from the cluster grid's list when the point is in the view
// frustum, which names only lights whose range reaches it, else from every local light.
vec3 DirectLight(
    vec3 position, vec3 N, vec3 faceNormal, vec3 V, vec3 albedo, float metallic, float roughness, vec3 energyCompensation,
    CoatParams coat, SheenParams sheen, SpecularParams specular, float sheenScaling, float coatTransmittance)
{
    vec3 result = vec3(0.0);
    int casterIndex = int(ubo.shadowParams.x);
    vec3 origin = OffsetRayOrigin(position, faceNormal);
    for (uint i = 0u; i < ubo.lightCounts.x; ++i)
    {
        SceneLightData light = sceneLights.lights[i];
        vec3 contribution = LayeredLight(
            light, position, N, V, albedo, metallic, roughness, energyCompensation, coat, sheen, specular, sheenScaling, coatTransmittance);
        if (any(greaterThan(contribution, vec3(0.0))))
        {
            vec3 toLight = normalize(-light.directionAndType.xyz);
            float visibility = dot(faceNormal, toLight) > 0.0 ? DirectionalVisibility(origin, toLight) : 0.0;
            if (int(i) == casterIndex)
            {
                visibility *= CloudShadow(position);
            }
            result += contribution * visibility;
        }
    }

    uint localCount = ubo.lightCounts.y - ubo.lightCounts.x;
    if (localCount == 0u || pathTrace.lightCandidates == 0u)
    {
        return result;
    }
    // The candidates: range.y lights to pick from, each standing for population / range.y of them. The
    // cluster grid covers the view frustum only.
    uvec2 range = uvec2(ubo.lightCounts.x, localCount);
    bool clustered = false;
    bool gridded = false;
    uint cell = 0u;
    float population = float(localCount);
    if ((pathTrace.flags & PT_FLAG_LIGHT_GRID) != 0u && LightGridCellOf(position, cell))
    {
        uint reaching = LightGridCount(cell);
        range = uvec2(0u, min(reaching, LIGHT_GRID_SLOTS));
        population = float(reaching);
        gridded = true;
    }
    else if (ubo.lightCounts.z != 0u)
    {
        vec4 clip = ubo.proj * ubo.view * vec4(position, 1.0);
        vec3 ndc = clip.xyz / max(clip.w, 1e-6);
        if (clip.w > 0.0 && all(lessThanEqual(abs(ndc.xy), vec2(1.0))))
        {
            range = lightClusters.ranges[FindLightCluster(position)];
            clustered = true;
            population = float(range.y);
        }
    }
    if (range.y == 0u)
    {
        return result;
    }
    float weightSum = 0.0;
    float chosenTarget = 0.0;
    uint chosenLight = 0u;
    vec3 coatContribution;
    vec3 sheenContribution;
    for (uint k = 0u; k < pathTrace.lightCandidates; ++k)
    {
        uint pick = min(uint(Random() * float(range.y)), range.y - 1u);
        uint lightIndex = gridded ? LightGridLight(cell, pick) : (clustered ? lightClusters.indices[range.x + pick] : range.x + pick);
        vec3 contribution = EvaluateSceneLight(
            sceneLights.lights[lightIndex], position, N, V, albedo, metallic, roughness, energyCompensation, NoCoat(), coatContribution,
            NoSheen(), sheenContribution, NoAnisotropy(), specular);
        float target = PathTraceLuminance(contribution);
        float weight = target * population;
        weightSum += weight;
        if (weight > 0.0 && Random() * weightSum < weight)
        {
            chosenTarget = target;
            chosenLight = lightIndex;
        }
    }
    if (chosenTarget <= 0.0)
    {
        return result;
    }
    SceneLightData chosen = sceneLights.lights[chosenLight];
    vec3 chosenContribution = coat.factor > 0.0 || HasSheen(sheen)
                                  ? LayeredLight(chosen, position, N, V, albedo, metallic, roughness, energyCompensation, coat, sheen, specular,
                                                 sheenScaling, coatTransmittance)
                                  : EvaluateSceneLight(chosen, position, N, V, albedo, metallic, roughness, energyCompensation, NoCoat(),
                                                       coatContribution, NoSheen(), sheenContribution, NoAnisotropy(), specular);
    float visibility = LocalVisibility(chosen, position, faceNormal);
    return result + chosenContribution / chosenTarget * (weightSum / float(pathTrace.lightCandidates)) * visibility;
}

// The light arriving at a G-buffer surface from direction, through the scene, physical units: the
// path's surfaces' emission and next event estimation, and the sky where it leaves. coneWidth and
// coneSpread are the ray cone's width where it starts and its spread angle, for the textures' level of
// detail. clampFirst: the first surface's contribution is held to the firefly clamp too (not for a
// sharp specular lobe, whose reflection of a lamp should stay as bright as the lamp). roughnessFloor
// is the regularization's: the least roughness the path's surfaces have. sharp: the path so far is
// a mirror-like reflection, whose rays test alpha-tested surfaces against their textures so leaves
// keep their shapes; behind any wider lobe the coverage decision gives the same average light.
vec3 TracePath(vec3 origin, vec3 direction, float coneWidth, float coneSpread, bool clampFirst, float roughnessFloor, bool sharp, float firstDensity)
{
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    // The density the last vertex picked direction with (solid angle), against which an emissive hit
    // weighs next event estimation's; 0 where that could not have found the hit (a refraction, a
    // volume's exit), which keeps all of the hit's light.
    float previousDensity = firstDensity;
    // Interfaces a path leaves a transmissive volume through: they are no surface of their own, and
    // do not count as bounces, up to this many.
    uint exits = 0u;
    for (uint bounce = 1u; bounce <= pathTrace.maxBounces; ++bounce)
    {
        rayTexturedAlpha = sharp;
        bool clamped = bounce > 1u || clampFirst;
        // The path's own rays meet transmissive surfaces whole, and a mirror-like path the Blend
        // surfaces too (glass, decals) by their coverage, so reflections show them; behind a wider lobe
        // those add little but the cost of their many candidate hits (foliage cards). The shadow rays
        // below see neither, as the lighting pass's.
        bool forwardSurfaces = (pathTrace.flags & PT_FLAG_FORWARD_SURFACES) != 0u;
        rayMeetsTransmission = forwardSurfaces;
        RayHit hit;
        bool found = TraceSceneRayMasked(
            origin, direction, 0.0, PT_MAX_DISTANCE, false, NextRayId(), forwardSurfaces && sharp ? RAY_MASK_PATH : RAY_MASK_VISIBILITY, hit);
        rayMeetsTransmission = false;
        if (bounce == 1u && exits == 0u)
        {
            g_firstHitDistance = found ? hit.t : PT_SKY_HIT_DISTANCE;
        }
        PathMedium medium = RayMedium(origin, direction, hit.t, !found);
        vec3 inscatter = throughput * medium.inscatter;
        radiance += clamped ? ClampContribution(inscatter) : inscatter;
        throughput *= medium.transmittance;
        if (!found)
        {
            vec3 sky = throughput * SkyRadiance(direction);
            radiance += clamped ? ClampContribution(sky) : sky;
            break;
        }
        RayMaterial rayMaterial = rayMaterials[rayInstances[hit.instance].data.z];
        uint materialFlags = floatBitsToUint(rayMaterial.emissionFlags.w);
        bool doubleSided = (materialFlags & RAY_MATERIAL_DOUBLE_SIDED) != 0u;
        TransmissionLobe transmission = TransmissionLobeOf(hit, (materialFlags & RAY_MATERIAL_TRANSMISSION) != 0u, doubleSided);
        if (!hit.frontFace && !doubleSided && transmission.factor <= 0.0)
        {
            // The inside of a closed mesh: no light.
            break;
        }
        RayHitSurface surface = RayHitSurfaceOf(hit, origin, direction);
        coneWidth += coneSpread * hit.t;
        vec3 V = -direction;
        if (transmission.volume && !hit.frontFace)
        {
            // Leaving a transmissive volume: the light its medium absorbed on the way through, then
            // out through the interface, or back in by its Fresnel (all of it past the critical angle).
            if (++exits > PT_MAX_VOLUME_EXITS)
            {
                break;
            }
            throughput *= transmission.absorption;
            vec3 refracted = refract(direction, surface.faceNormal, transmission.ior);
            float F0 = (transmission.ior - 1.0) / (transmission.ior + 1.0);
            float F = dot(refracted, refracted) == 0.0 ? 1.0 : FresnelSchlick(abs(dot(refracted, surface.faceNormal)), vec3(F0 * F0)).x;
            bool reflects = Random() < F;
            direction = reflects ? reflect(direction, surface.faceNormal) : refracted;
            origin = OffsetRayOrigin(surface.position, reflects ? surface.faceNormal : -surface.faceNormal);
            previousDensity = 0.0;
            --bounce;
            continue;
        }
        float cosTheta = abs(dot(surface.normal, V));
        RayHitShading material = RayHitShadingOf(surface, coneWidth, cosTheta);
        if ((material.flags & SHADING_FLAG_UNLIT) != 0u)
        {
            // Lit to the display's paper white at every exposure, as the lighting pass shows it.
            vec3 unlit = throughput * material.albedo * (kFrameBufferUnitsPerExposed * ubo.exposure.y);
            radiance += clamped ? ClampContribution(unlit) : unlit;
            break;
        }

        // The surface as the G-buffer's is shaded, but from its material's factors where the G-buffer
        // reads maps: the coat, the sheen and the dielectric specular. Its normal map where a
        // mirror-like path sees it; behind a wider lobe the map's detail averages away.
        vec3 N = PT_LAYERED != 0 && sharp ? RayHitMappedNormal(hit, surface, coneWidth, cosTheta) : surface.normal;
        CoatParams coat;
        SheenParams sheen;
        SpecularParams specular;
        RayHitLayersOf(surface, coat, sheen, specular);
        if (transmission.factor > 0.0)
        {
            // KHR_materials_transmission: for the direct lights, the lobe through the surface, as the
            // forward pass gives it; below, the paths' own share of the diffuse.
            specular.transmissionFactor = transmission.factor;
            specular.transmissionTint = material.albedo;
            specular.transmissionAlpha = max(TransmissionRoughness(material.roughness * material.roughness, transmission.ior), 1e-3);
        }
        float NdV = max(dot(N, V), 1e-4);
        material.roughness = max(material.roughness, roughnessFloor);
        coat.roughness = max(coat.roughness, roughnessFloor);
        PathTraceLobes lobes = PathTraceLobesOf(N, V, material.albedo, material.metallic, material.roughness, specular, coat, sheen);
        float sheenScaling = HasSheen(sheen) ? 1.0 - max(sheen.color.r, max(sheen.color.g, sheen.color.b)) * SampleSheenAlbedo(sheen.roughness, NdV) : 1.0;
        float coatTransmittance = 1.0 - coat.factor * FresnelSchlick(max(dot(coat.normal, V), 0.0), COAT_F0).x;

        // The lobes the next direction is picked from: the transmission lobe (the share of the diffuse
        // the transmission takes over, through the surface), the diffuse lobe, the base's specular one
        // or the coat's, in proportion to their albedos (the sheen's own lobe is left to next event
        // estimation, as at the G-buffer's surface).
        vec3 transmittedAlbedo = lobes.diffuse * transmission.factor;
        vec3 diffuseAlbedo = lobes.diffuse - transmittedAlbedo;
        float transmittedWeight = PathTraceLuminance(transmittedAlbedo);
        float diffuseWeight = PathTraceLuminance(diffuseAlbedo);
        float specularWeight = PathTraceLuminance(lobes.specular);
        float coatWeight = PathTraceLuminance(lobes.coat);
        float lobeTotal = transmittedWeight + diffuseWeight + specularWeight + coatWeight;
        vec4 lobeWeights = vec4(diffuseWeight, specularWeight, coatWeight, lobeTotal);

        // An emissive surface's own light, less what next event estimation would have found of it
        // from the last vertex (MIS); and that estimation here, for the emissive triangles, weighed
        // against this vertex's next direction (none from the last vertex).
        vec3 emission = material.emissive;
        vec3 emissiveLight = vec3(0.0);
        if (EmissiveLightsOn())
        {
            if (previousDensity > 0.0 && any(greaterThan(emission, vec3(0.0))))
            {
                emission *= MisWeight(previousDensity, EmissiveHitDensity(hit, surface.faceNormal, direction));
            }
            vec3 L;
            vec3 light;
            float density;
            vec3 target;
            if (bounce <= PT_EMISSIVE_NEE_BOUNCES && EmissiveSample(surface.position, surface.faceNormal, coneWidth, L, light, density, target))
            {
                float pathDensity = bounce < pathTrace.maxBounces
                                        ? PathVertexDensity(N, coat.normal, V, L, material.roughness, coat.roughness, lobeWeights)
                                        : 0.0;
                emissiveLight = LayeredReflection(N, V, L, light, material.albedo, material.metallic, material.roughness,
                                                  lobes.energyCompensation, coat, sheen, specular, sheenScaling, coatTransmittance) *
                                MisWeight(density, pathDensity);
                emissiveLight *= EmissiveShadowWeight(surface.position, surface.faceNormal, target,
                                                      PathTraceLuminance(emissiveLight * throughput));
            }
        }
        vec3 emitted = emission + emissiveLight +
                       DirectLight(surface.position, N, surface.faceNormal, V, material.albedo, material.metallic, material.roughness,
                                   lobes.energyCompensation, coat, sheen, specular, sheenScaling, coatTransmittance);
        emitted *= throughput;
        radiance += clamped ? ClampContribution(emitted) : emitted;
        if (bounce == pathTrace.maxBounces || lobeTotal <= 0.0)
        {
            break;
        }
        float lobePick = Random() * lobeTotal;
        vec3 nextDirection;
        if (lobePick < transmittedWeight)
        {
            // Straight on through a thin wall; into a volume refracted by a microfacet of the
            // transmission's roughness (the IOR scales it, as the forward pass's blur).
            nextDirection = direction;
            if (transmission.volume)
            {
                float lobeRoughness = material.roughness * clamp(transmission.ior * 2.0 - 2.0, 0.0, 1.0);
                vec3 H = SampleGgxVisibleNormal(surface.faceNormal, V, max(lobeRoughness, 0.04), vec2(Random(), Random()));
                nextDirection = refract(direction, H, 1.0 / transmission.ior);
                if (dot(nextDirection, nextDirection) == 0.0)
                {
                    break;
                }
                coneSpread += lobeRoughness * lobeRoughness;
                sharp = sharp && lobeRoughness < PT_SHARP_ROUGHNESS;
            }
            throughput *= transmittedAlbedo / (transmittedWeight / lobeTotal);
            if (dot(nextDirection, surface.faceNormal) >= 0.0)
            {
                break;
            }
        }
        else if (lobePick >= transmittedWeight + diffuseWeight)
        {
            bool throughCoat = lobePick >= transmittedWeight + diffuseWeight + specularWeight;
            float probability = (throughCoat ? coatWeight : specularWeight) / lobeTotal;
            vec3 lobeNormal = throughCoat ? coat.normal : N;
            float lobeRoughness = throughCoat ? coat.roughness : material.roughness;
            vec3 H = SampleGgxVisibleNormal(lobeNormal, V, lobeRoughness, vec2(Random(), Random()));
            nextDirection = reflect(-V, H);
            float lobeNdV = max(dot(lobeNormal, V), 1e-4);
            float NdL = dot(lobeNormal, nextDirection);
            if (NdL <= 0.0)
            {
                break;
            }
            float VdH = max(dot(V, H), 0.0);
            float alpha = lobeRoughness * lobeRoughness;
            vec3 weight = throughCoat ? vec3(coat.factor * FresnelSchlick(VdH, COAT_F0).x)
                                      : mix(FresnelSchlick(VdH, specular.dielectricF0, specular.dielectricF90), FresnelSchlick(VdH, material.albedo),
                                            material.metallic) *
                                            lobes.energyCompensation * lobes.baseScale;
            throughput *= weight * SmithG2OverG1(lobeNdV, NdL, alpha) / probability;
            coneSpread += alpha;
            sharp = sharp && lobeRoughness < PT_SHARP_ROUGHNESS;
        }
        else
        {
            nextDirection = CosineSampleHemisphere(N, vec2(Random(), Random()));
            throughput *= diffuseAlbedo / (diffuseWeight / lobeTotal);
            coneSpread += PT_DIFFUSE_SPREAD;
            roughnessFloor = max(roughnessFloor, Regularization());
            sharp = false;
        }
        bool through = dot(nextDirection, surface.faceNormal) < 0.0;
        if (through && lobePick >= transmittedWeight)
        {
            break;
        }
        previousDensity = 0.0;
        if (lobePick >= transmittedWeight && EmissiveLightsOn() && bounce <= PT_EMISSIVE_NEE_BOUNCES)
        {
            previousDensity = PathVertexDensity(N, coat.normal, V, nextDirection, material.roughness, coat.roughness, lobeWeights);
        }
        // Russian roulette from the third surface on, by what the path can still carry.
        if (bounce >= 2u)
        {
            float survival = min(max(throughput.r, max(throughput.g, throughput.b)), 0.95);
            if (Random() >= survival)
            {
                break;
            }
            throughput /= survival;
        }
        origin = OffsetRayOrigin(surface.position, through ? -surface.faceNormal : surface.faceNormal);
        direction = nextDirection;
    }
    return radiance;
}

vec4 Sanitize(vec3 value)
{
    if (any(isnan(value)) || any(isinf(value)))
    {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }
    return vec4(min(max(value, vec3(0.0)), vec3(65504.0)), 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(pathTrace.extent))))
    {
        return;
    }
    uint target = (pathTrace.flags & (PT_FLAG_ACCUMULATE | PT_FLAG_DENOISE)) != 0u ? PT_IMAGE_RAW : PT_IMAGE_FINAL;
    ivec2 gbufferPixel = PtGBufferPixel(pixel);
    float depth = texelFetch(ptDepth, gbufferPixel, 0).r;
    if (!PathTraceSurfaceShaded(pixel, depth) || pathTrace.maxBounces == 0u)
    {
        StorePathTracePair(target, pixel, vec4(0.0, 0.0, 0.0, 1.0), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    g_rngState = HashUint(uint(pixel.x) + uint(pixel.y) * 65536u) ^ HashUint(pathTrace.frameIndex * 0x9e3779b9u + 0x632be5abu);

    // The surface as the lighting pass reads it.
    vec3 worldPosition = PathTraceWorldPosition(pixel, depth);
    vec3 albedo = texelFetch(ptAlbedo, gbufferPixel, 0).rgb;
    vec4 normals = texelFetch(ptNormal, gbufferPixel, 0);
    vec3 N = DecodeNormalOctahedral(normals.rg);
    vec3 geoNormal = DecodeNormalOctahedral(normals.ba);
    vec4 surfaceData = texelFetch(ptSurface, gbufferPixel, 0);
    float metallic = surfaceData.r;
    float roughness = clamp(surfaceData.g, 0.04, 1.0);
    uint flags = DecodeShadingFlags(surfaceData.a);
    CoatParams coat = NoCoat();
    SheenParams sheen = NoSheen();
    SpecularParams specular = NoSpecularOverride();
    if ((flags & SHADING_FLAG_CLEARCOAT) != 0u)
    {
        vec4 coatData = texelFetch(ptCoat, gbufferPixel, 0);
        coat.factor = coatData.r;
        coat.roughness = clamp(coatData.g, 0.04, 1.0);
        coat.normal = (flags & SHADING_FLAG_COAT_NORMAL) != 0u ? DecodeNormalOctahedral(texelFetch(ptVelocity, gbufferPixel, 0).ba) : geoNormal;
    }
    if ((flags & SHADING_FLAG_SHEEN) != 0u)
    {
        vec4 sheenData = texelFetch(ptSheen, gbufferPixel, 0);
        sheen.color = sheenData.rgb;
        sheen.roughness = clamp(sheenData.a, 0.04, 1.0);
    }
    if ((flags & SHADING_FLAG_SPECULAR) != 0u)
    {
        vec4 specularData = texelFetch(ptSpecular, gbufferPixel, 0);
        specular.dielectricF0 = specularData.rgb * specularData.rgb;
        specular.dielectricF90 = specularData.a;
    }
    vec3 V = normalize(ubo.cameraWorldPosition.xyz - worldPosition);
    PathTraceLobes lobes = PathTraceLobesOf(N, V, albedo, metallic, roughness, specular, coat, sheen);

    // Off the surface by more than the depth buffer's reconstruction error, which grows with distance.
    float distanceToCamera = length(ubo.cameraWorldPosition.xyz - worldPosition);
    vec3 origin = OffsetRayOrigin(worldPosition + geoNormal * (0.002 + 0.0004 * distanceToCamera), geoNormal);
    // A pixel's footprint where the paths leave, and the angle it widens by.
    float pixelAngle = 2.0 / (abs(ubo.proj[1][1]) * pathTrace.extent.y);
    float coneWidth = distanceToCamera * pixelAngle;

    // The two paths' first directions and weights, then one loop that traces both: TracePath is
    // compiled once, which keeps the shader's registers, and so its occupancy, those of one path.
    // The diffuse path is cosine-weighted, so the lobe's weight is its albedo, which demodulates to 1.
    // The specular path leaves through the base's lobe or the coat's, by their albedos.
    vec3 directions[2];
    vec3 weights[2] = vec3[2](vec3(0.0), vec3(0.0));
    float spreads[2] = float[2](pixelAngle + PT_DIFFUSE_SPREAD, pixelAngle);
    bool clampFirst[2] = bool[2](true, false);
    bool sharp[2] = bool[2](false, false);
    float roughnessFloors[2] = float[2](Regularization(), 0.0);
    float densities[2] = float[2](0.0, 0.0);
    directions[0] = CosineSampleHemisphere(N, vec2(Random(), Random()));
    bool hasDiffuse = PathTraceLuminance(lobes.diffuse) > 0.0;
    if (hasDiffuse && dot(directions[0], geoNormal) > 0.0)
    {
        weights[0] = vec3(1.0);
        densities[0] = max(dot(N, directions[0]), 0.0) / PI;
    }
    vec3 specularAlbedo = lobes.specular + lobes.coat;
    float baseWeight = PathTraceLuminance(lobes.specular);
    float coatWeight = PathTraceLuminance(lobes.coat);
    float coatProbability = baseWeight + coatWeight > 0.0 ? coatWeight / (baseWeight + coatWeight) : 0.0;
    directions[1] = N;
    if (baseWeight + coatWeight > 0.0)
    {
        bool throughCoat = Random() < coatProbability;
        vec3 lobeNormal = throughCoat ? coat.normal : N;
        float lobeRoughness = throughCoat ? coat.roughness : roughness;
        vec3 H = SampleGgxVisibleNormal(lobeNormal, V, lobeRoughness, vec2(Random(), Random()));
        directions[1] = reflect(-V, H);
        float NdV = max(dot(lobeNormal, V), 1e-4);
        float NdL = dot(lobeNormal, directions[1]);
        if (NdL > 0.0 && dot(directions[1], geoNormal) > 0.0)
        {
            float VdH = max(dot(V, H), 0.0);
            float alpha = lobeRoughness * lobeRoughness;
            vec3 weight;
            if (throughCoat)
            {
                weight = vec3(coat.factor * FresnelSchlick(VdH, COAT_F0).x) / coatProbability;
            }
            else
            {
                vec3 F = mix(FresnelSchlick(VdH, specular.dielectricF0, specular.dielectricF90), FresnelSchlick(VdH, albedo), metallic);
                weight = F * lobes.energyCompensation * lobes.baseScale / (1.0 - coatProbability);
            }
            weights[1] = weight * SmithG2OverG1(NdV, NdL, alpha) / max(specularAlbedo, vec3(1e-3));
            spreads[1] += alpha;
            clampFirst[1] = lobeRoughness > 0.25;
            sharp[1] = lobeRoughness < PT_SHARP_ROUGHNESS;
            densities[1] = (1.0 - coatProbability) * GgxReflectionDensity(N, V, directions[1], roughness) +
                           (coat.factor > 0.0 ? coatProbability * GgxReflectionDensity(coat.normal, V, directions[1], coat.roughness) : 0.0);
        }
    }

    // Next event estimation for the emissive triangles here, as the lighting pass does it for the
    // analytic lights: one point, one shadow ray, into both channels, each weighed against its own
    // path's direction (MIS) and demodulated as that path is (the diffuse one a Lambert lobe, by its
    // cosine-weighted directions).
    vec3 emissiveDiffuse = vec3(0.0);
    vec3 emissiveSpecular = vec3(0.0);
    if (EmissiveLightsOn())
    {
        vec3 L;
        vec3 incoming;
        float density;
        vec3 target;
        if (EmissiveSample(origin, geoNormal, coneWidth, L, incoming, density, target))
        {
            float NdL = dot(N, L);
            if (hasDiffuse && NdL > 0.0)
            {
                emissiveDiffuse = ClampContribution(incoming * (NdL / PI) * MisWeight(density, NdL / PI));
            }
            if (baseWeight + coatWeight > 0.0)
            {
                vec3 H = normalize(V + L);
                float VdH = max(dot(V, H), 0.0);
                vec3 F = mix(FresnelSchlick(VdH, specular.dielectricF0, specular.dielectricF90), FresnelSchlick(VdH, albedo), metallic);
                vec3 reflected = NdL > 0.0 ? IsotropicSpecularTerm(N, V, L, H, roughness) * NdL * F * lobes.energyCompensation * lobes.baseScale : vec3(0.0);
                float pathDensity = (1.0 - coatProbability) * GgxReflectionDensity(N, V, L, roughness);
                if (coat.factor > 0.0)
                {
                    reflected += coat.factor * EvaluateCoatSpecular(coat, V, L, 1.0, vec3(1.0));
                    pathDensity += coatProbability * GgxReflectionDensity(coat.normal, V, L, coat.roughness);
                }
                emissiveSpecular = incoming * reflected / max(specularAlbedo, vec3(1e-3)) * MisWeight(density, pathDensity);
                if (min(roughness, coat.factor > 0.0 ? coat.roughness : 1.0) > 0.25)
                {
                    emissiveSpecular = ClampContribution(emissiveSpecular);
                }
            }
            // The lobes' albedos bring the demodulated light back to what it adds to the pixel.
            float shadow = EmissiveShadowWeight(origin, geoNormal, target,
                                                max(PathTraceLuminance(emissiveDiffuse * lobes.diffuse), PathTraceLuminance(emissiveSpecular * specularAlbedo)));
            emissiveDiffuse *= shadow;
            emissiveSpecular *= shadow;
        }
    }

    vec3 light[2] = vec3[2](vec3(0.0), vec3(0.0));
    float specularHitDistance = 0.0;
    for (int path = 0; path < 2; ++path)
    {
        if (any(greaterThan(weights[path], vec3(0.0))))
        {
            light[path] = TracePath(origin, directions[path], coneWidth, spreads[path], clampFirst[path], roughnessFloors[path], sharp[path],
                                    densities[path]) *
                          weights[path];
            specularHitDistance = path == 1 ? g_firstHitDistance : specularHitDistance;
        }
    }
    vec3 diffuse = light[0] + emissiveDiffuse;
    vec3 specularLight = light[1] + emissiveSpecular;

    // Ray reconstruction's specular hit distance rides in the specular channel's alpha (dlss_rr_guides.comp
    // reads it), which nothing else reads of the result.
    vec4 specularResult = Sanitize(specularLight * ubo.exposure.x);
    if ((pathTrace.flags & PT_FLAG_HIT_DISTANCE) != 0u)
    {
        specularResult.a = min(specularHitDistance, 65000.0);
    }
    StorePathTracePair(target, pixel, Sanitize(diffuse * ubo.exposure.x), specularResult);
}
