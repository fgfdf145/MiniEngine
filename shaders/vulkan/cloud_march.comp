#version 450
#extension GL_GOOGLE_include_directive : require

#include "scene_common.glsl"
#include "atmosphere_sampling.glsl"
#include "volumetric_clouds.glsl"
#include "cloud_reconstruction.glsl"

// The volumetric clouds, one pixel of every 2 x 2 block of the scene per frame
// (VulkanAtmosphere::RecordClouds; cloud_reconstruction.glsl). Per texel, for the block's pixel this
// frame marches: rgb the light the clouds and the haze in front of them send toward the camera,
// times CLOUD_TARGET_SCALE; a the transmittance through them. cloud_resolve.comp builds the full
// extent from it and the history.
layout(local_size_x = 8, local_size_y = 8) in;

// Set 1 binding 11 of the atmosphere's compute set.
layout(set = 1, binding = 11, rgba16f) uniform writeonly image2D cloudSamplesOut;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, imageSize(cloudSamplesOut))))
    {
        return;
    }
    vec4 result = vec4(0.0, 0.0, 0.0, 1.0);
    if (CloudsEnabled())
    {
        ivec2 extent = CloudSceneExtent();
        ivec2 pixel = min(texel * 2 + CloudMarchedPixelInBlock(), extent - 1);
        vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
        vec3 direction = ViewDirectionFromTexCoord(uv + CloudJitterUv());
        vec4 clouds = CloudLayer(direction, SampleSkyForLighting(direction), CloudJitter(vec2(pixel)), 32, 96);
        result = vec4(min(clouds.rgb * CLOUD_TARGET_SCALE, vec3(65504.0)), clouds.a);
    }
    imageStore(cloudSamplesOut, texel, result);
}
