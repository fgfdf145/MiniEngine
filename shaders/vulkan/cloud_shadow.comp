#version 450
#extension GL_GOOGLE_include_directive : require

#include "scene_common.glsl"
#include "atmosphere_sampling.glsl"
#include "volumetric_clouds.glsl"

// The cloud shadow map (cloud_shadow.glsl), every frame: per texel, the clouds' transmittance along
// the ray from its point of the ground (world y = 0) toward the sun, through the base shape without
// the detail, which a texel of 31 m could not hold anyway.
layout(local_size_x = 8, local_size_y = 8) in;

// Set 1 binding 9 of the atmosphere's compute set.
layout(set = 1, binding = 9, rgba16f) uniform writeonly image2D cloudShadowOut;

const int CLOUD_SHADOW_STEPS = 16;
// Far enough for the sun 3 degrees up to cross a 10 km layer.
const float CLOUD_SHADOW_MAX_DISTANCE_KM = 200.0;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(CLOUD_SHADOW_MAP_SIZE))))
    {
        return;
    }
    vec3 sun = ubo.sunDirectionAndMode.xyz;
    float transmittance = 1.0;
    if (CloudShadowsEnabled() && sun.y > 0.0)
    {
        vec2 groundMeters = CloudShadowMapCenter() + ((vec2(texel) + 0.5) / CLOUD_SHADOW_MAP_SIZE - 0.5) * CLOUD_SHADOW_EXTENT_M;
        // World metres to the atmosphere's planet-centred kilometres, as ToAtmosphereCameraPositionKm.
        vec3 origin = vec3(groundMeters.x * 0.001, BottomRadius(), groundMeters.y * 0.001);
        float inner = BottomRadius() + ubo.cloudLayer.x;
        float thickness = ubo.cloudLayer.y;
        // The planet a kilometre down, so the ray leaving the ground is not stopped by it.
        vec2 span = CloudShellInterval(origin, sun, BottomRadius() - 1.0, inner, inner + thickness, CLOUD_SHADOW_MAX_DISTANCE_KM);
        if (span.y > span.x)
        {
            float dt = (span.y - span.x) / float(CLOUD_SHADOW_STEPS);
            float opticalDepth = 0.0;
            for (int step = 0; step < CLOUD_SHADOW_STEPS; ++step)
            {
                vec3 p = origin + sun * (span.x + (float(step) + 0.5) * dt);
                opticalDepth += CloudExtinction(p, (length(p) - inner) / thickness, 0.0) * dt;
            }
            transmittance = exp(-opticalDepth);
        }
    }
    imageStore(cloudShadowOut, texel, vec4(transmittance, 0.0, 0.0, 1.0));
}
