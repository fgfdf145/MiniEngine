#version 450
#extension GL_GOOGLE_include_directive : require

// The DDGI debug views, written over SceneGi after the one-bounce composite has used it (the tone
// mapping pass shows SceneGi for them):
// - Ray-traced scene (view 14): one primary ray per pixel through the ray scene, showing the hit's ray
//   material albedo lit by the first directional light through a traced shadow ray, plus a fifth of
//   it unlit. Back faces of single-sided surfaces show red, the sky a flat blue. Against the Albedo
//   view it checks the hierarchies, the instances and the ray materials; against the image, the
//   shadow rays.

#include "scene_common.glsl"
#include "ray_tracing_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 10, std430) readonly buffer SceneLightBuffer
{
    SceneLightData lights[];
}
sceneLights;

layout(set = 2, binding = 0, rgba16f) uniform writeonly image2D outputImage;

// Must match DdgiDebugConstants in engine/renderer/vulkan/ddgi_debug_pass.cpp.
layout(push_constant) uniform DdgiDebugConstants
{
    vec2 extent;
    vec2 invExtent;
    uint view;
    uint frameIndex;
}
constants;

const uint VIEW_RAY_TRACED = 14u;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), constants.extent)))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) * constants.invExtent;
    vec4 farPoint = ubo.invViewProj * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 origin = ubo.cameraWorldPosition.xyz;
    vec3 direction = normalize(farPoint.xyz / farPoint.w - origin);
    uint rayId = uint(pixel.y) * uint(constants.extent.x) + uint(pixel.x);

    vec3 color = vec3(0.25, 0.4, 0.7);
    RayHit hit;
    if (TraceSceneRay(origin, direction, 0.0, 1e30, false, rayId, hit))
    {
        RayMaterial material = RayHitMaterial(hit);
        vec3 normal = RayHitNormal(hit);
        bool doubleSided = (floatBitsToUint(material.emissionFlags.w) & RAY_MATERIAL_DOUBLE_SIDED) != 0u;
        if (!hit.frontFace && !doubleSided)
        {
            color = vec3(0.8, 0.05, 0.05);
        }
        else
        {
            normal = dot(normal, direction) > 0.0 ? -normal : normal;
            vec3 position = origin + direction * hit.t;
            float lit = 0.0;
            if (ubo.lightCounts.x > 0u)
            {
                vec3 toLight = -normalize(sceneLights.lights[0].directionAndType.xyz);
                float cosine = max(dot(normal, toLight), 0.0);
                RayHit shadowHit;
                if (cosine > 0.0 && !TraceSceneRay(OffsetRayOrigin(position, normal), toLight, 0.0, 1e30, true, rayId ^ 0x9e3779b9u, shadowHit))
                {
                    lit = cosine;
                }
            }
            color = material.albedoCoverage.rgb * (0.2 + 0.8 * lit);
        }
    }
    imageStore(outputImage, pixel, vec4(color, 1.0));
}
