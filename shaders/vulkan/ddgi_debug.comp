#version 460
#extension GL_GOOGLE_include_directive : require
#ifdef RAY_QUERY
// The hardware variant of ray_tracing_common.glsl's TraceSceneRay.
#extension GL_EXT_ray_query : require
#endif

// The DDGI debug views, written over SceneGi after the one-bounce composite has used it (the tone
// mapping pass shows SceneGi for them):
// - Ray-traced scene (view 14): one primary ray per pixel through the ray scene, showing the hit's ray
//   material albedo lit by the first directional light through a traced shadow ray, plus a fifth of
//   it unlit. Back faces of single-sided surfaces show red, the sky a flat blue. Against the Albedo
//   view it checks the hierarchies, the instances and the ray materials; against the image, the
//   shadow rays.
// - DDGI probes (view 16): the image with every probe of one level (DdgiSettings::probeViewLevel)
//   drawn as a small sphere (a twentieth of the spacing) showing its irradiance toward the viewer, found by walking each level's grid along the
//   pixel's ray up to the surface; inactive probes red, probes not yet updated for where they are
//   blue.
// - DDGI irradiance (view 15): what the probes send each pixel's surface, irradiance / pi pre-exposed
//   like SceneGi, before the albedo; black where the volume does not reach (the SH sky lights it).

#include "scene_common.glsl"
#include "ray_tracing_common.glsl"
#include "ddgi_common.glsl"
#include "ground_plane.glsl"
#include "gbuffer_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 10, std430) readonly buffer SceneLightBuffer
{
    SceneLightData lights[];
}
sceneLights;

layout(set = 2, binding = 0, rgba16f) uniform writeonly image2D outputImage;
layout(set = 2, binding = 1) uniform sampler2D depthTexture;
layout(set = 2, binding = 2) uniform sampler2D normalTexture;

// Must match DdgiDebugConstants in engine/renderer/vulkan/ddgi_debug_pass.cpp.
layout(push_constant) uniform DdgiDebugConstants
{
    vec2 extent;
    vec2 invExtent;
    uint view;
    uint frameIndex;
}
constants;

const uint VIEW_RAY_TRACED = 14u;
const uint VIEW_DDGI_IRRADIANCE = 15u;
const uint VIEW_DDGI_PROBES = 16u;

layout(set = 2, binding = 3) uniform sampler2D hdrTexture;

// The nearest probe sphere of one level the ray meets before maxT: walks the level's cells along the
// ray (Amanatides and Woo) and tests the eight probes around each.
bool FindProbe(uint level, vec3 origin, vec3 direction, float maxT, inout float bestT, out vec3 color)
{
    color = vec3(0.0);
    float spacing = DdgiLevelSpacing(level);
    ivec3 gridOrigin = DdgiLevelOrigin(level);
    float radius = 0.05 * spacing;
    vec3 start = origin / spacing - vec3(gridOrigin);
    vec3 inverse = SafeInverse(direction);
    // Enter the grid's box.
    vec3 t0 = (vec3(0.0) - start) * inverse;
    vec3 t1 = (vec3(DDGI_GRID - 1) - start) * inverse;
    float enter = max(max(min(t0.x, t1.x), min(t0.y, t1.y)), max(min(t0.z, t1.z), 0.0));
    float exit = min(min(max(t0.x, t1.x), max(t0.y, t1.y)), min(max(t0.z, t1.z), maxT / spacing));
    if (enter > exit)
    {
        return false;
    }
    vec3 position = start + direction * enter;
    ivec3 cell = clamp(ivec3(floor(position)), ivec3(0), DDGI_GRID - 2);
    ivec3 stepDirection = ivec3(sign(direction));
    vec3 nextBoundary = (vec3(cell) + max(vec3(stepDirection), vec3(0.0)) - start) * inverse;
    vec3 delta = abs(inverse);
    bool found = false;
    for (int steps = 0; steps < 96; ++steps)
    {
        for (int corner = 0; corner < 8; ++corner)
        {
            ivec3 coord = gridOrigin + cell + ivec3(corner & 1, (corner >> 1) & 1, (corner >> 2) & 1);
            ivec3 slot = DdgiStorageSlot(coord);
            DdgiProbeState state = ddgiProbeStates[level * DDGI_PROBES_PER_LEVEL + DdgiSlotIndex(slot)];
            vec3 center = DdgiProbePosition(level, coord, state);
            vec3 toCenter = center - origin;
            float along = dot(toCenter, direction);
            float squared = dot(toCenter, toCenter) - along * along;
            if (squared > radius * radius)
            {
                continue;
            }
            float t = along - sqrt(radius * radius - squared);
            if (t <= 0.0 || t >= bestT || t >= maxT)
            {
                continue;
            }
            bestT = t;
            found = true;
            bool current = state.coordAndFlags.xyz == coord && (state.coordAndFlags.w & DDGI_PROBE_UPDATED) != 0;
            if (!current)
            {
                color = vec3(0.0, 0.0, 1.0);
            }
            else if ((state.coordAndFlags.w & DDGI_PROBE_INACTIVE) != 0)
            {
                color = vec3(1.0, 0.0, 0.0);
            }
            else
            {
                vec3 normal = normalize(origin + direction * t - center);
                vec2 size = vec2(textureSize(ddgiIrradianceAtlas, 0).xy);
                vec3 irradiance = textureLod(ddgiIrradianceAtlas, vec3(DdgiAtlasUv(slot, normal, DDGI_IRRADIANCE_TEXELS, size), float(level)), 0.0).rgb;
                // Pre-exposed and scaled back to the display's unit, as the tone mapping pass shows SceneGi.
                color = irradiance * ubo.exposure.x;
            }
        }
        if (found)
        {
            return true;
        }
        // To the next cell.
        if (nextBoundary.x < nextBoundary.y && nextBoundary.x < nextBoundary.z)
        {
            cell.x += stepDirection.x;
            nextBoundary.x += delta.x;
        }
        else if (nextBoundary.y < nextBoundary.z)
        {
            cell.y += stepDirection.y;
            nextBoundary.y += delta.y;
        }
        else
        {
            cell.z += stepDirection.z;
            nextBoundary.z += delta.z;
        }
        // A sphere reaches a cell beyond its own, so the walk goes one cell past the exit.
        if (any(lessThan(cell, ivec3(0))) || any(greaterThan(cell, DDGI_GRID - 2)) || min(min(nextBoundary.x, nextBoundary.y), nextBoundary.z) > exit + 1.0)
        {
            return false;
        }
    }
    return false;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), constants.extent)))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) * constants.invExtent;
    if (constants.view == VIEW_DDGI_PROBES)
    {
        float depth = textureLod(depthTexture, uv, 0.0).r;
        vec4 world = ubo.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
        vec4 far = ubo.invViewProj * vec4(uv * 2.0 - 1.0, DEPTH_FAR, 1.0);
        vec3 origin = ubo.cameraWorldPosition.xyz;
        vec3 direction = normalize(far.xyz / far.w - origin);
        float maxT = !IsFarDepth(depth) ? length(world.xyz / world.w - origin) : 1e30;
        vec3 color = textureLod(hdrTexture, uv, 0.0).rgb;
        float bestT = maxT;
        uint level = uint(ubo.ddgiParams.y);
        vec3 probeColor;
        if (level < DdgiLevelCount() && FindProbe(level, origin, direction, maxT, bestT, probeColor))
        {
            color = probeColor;
        }
        imageStore(outputImage, pixel, vec4(color, 1.0));
        return;
    }
    if (constants.view == VIEW_DDGI_IRRADIANCE)
    {
        float depth = textureLod(depthTexture, uv, 0.0).r;
        vec3 irradiance = vec3(0.0);
        if (!IsFarDepth(depth) && DdgiLevelCount() > 0u)
        {
            vec4 world = ubo.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
            vec3 P = world.xyz / world.w;
            vec3 N = DecodeNormalOctahedral(textureLod(normalTexture, uv, 0.0).rg);
            float weight;
            irradiance = DdgiIrradiance(P, N, normalize(ubo.cameraWorldPosition.xyz - P), weight).rgb * ubo.exposure.x;
        }
        imageStore(outputImage, pixel, vec4(irradiance, 1.0));
        return;
    }
    vec4 farPoint = ubo.invViewProj * vec4(uv * 2.0 - 1.0, DEPTH_FAR, 1.0);
    vec3 origin = ubo.cameraWorldPosition.xyz;
    vec3 direction = normalize(farPoint.xyz / farPoint.w - origin);
    uint rayId = uint(pixel.y) * uint(constants.extent.x) + uint(pixel.x);

    vec3 color = vec3(0.25, 0.4, 0.7);
    RayHit hit;
    bool sceneHit = TraceSceneRay(origin, direction, 0.0, 1e30, false, rayId, hit);
    float groundT;
    bool groundFrontFace;
    bool groundHit = IntersectGroundPlane(origin, direction, 0.0, sceneHit ? hit.t : 1e30, groundT, groundFrontFace);
    if (sceneHit || groundHit)
    {
        vec3 albedo;
        vec3 normal;
        bool frontFace;
        float t;
        if (groundHit)
        {
            albedo = ubo.groundAlbedo.rgb;
            normal = vec3(0.0, 1.0, 0.0);
            frontFace = groundFrontFace;
            t = groundT;
        }
        else
        {
            RayMaterial material = RayHitMaterial(hit);
            albedo = material.albedoCoverage.rgb;
            normal = RayHitNormal(hit);
            frontFace = hit.frontFace || (floatBitsToUint(material.emissionFlags.w) & RAY_MATERIAL_DOUBLE_SIDED) != 0u;
            t = hit.t;
        }
        if (!frontFace)
        {
            color = vec3(0.8, 0.05, 0.05);
        }
        else
        {
            normal = dot(normal, direction) > 0.0 ? -normal : normal;
            vec3 position = origin + direction * t;
            float lit = 0.0;
            if (ubo.lightCounts.x > 0u)
            {
                vec3 toLight = -normalize(sceneLights.lights[0].directionAndType.xyz);
                float cosine = max(dot(normal, toLight), 0.0);
                RayHit shadowHit;
                if (cosine > 0.0 && !TraceSceneRay(OffsetRayOrigin(position, normal), toLight, 0.0, 1e30, true, rayId ^ 0x9e3779b9u, shadowHit))
                {
                    lit = cosine;
                }
            }
            color = albedo * (0.2 + 0.8 * lit);
        }
    }
    imageStore(outputImage, pixel, vec4(color, 1.0));
}
