#version 450

// One submesh's ray material (RayMaterial in ray_tracing_common.glsl): what a DDGI probe ray sees of
// it, without textures. A 16 x 16 grid of samples over the texture at the mip nearest 16 texels
// across: the albedo is the base colour's average over the covered samples, the coverage the share
// of samples that stop light (Mask: alpha at or above the cutoff; Blend: the alpha itself, though
// the ray scene leaves Blend surfaces out of the traces; Opaque: all), times what transmission lets
// through; the emission the emissive texture's average. Texture
// transforms and the second UV set are ignored: an average does not depend on them much.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D baseColorTexture;
layout(set = 0, binding = 1) uniform sampler2D emissiveTexture;

struct RayMaterial
{
    vec4 albedoCoverage;
    vec4 emissionFlags;
};

// Every slot's set names its textures; the materials buffer is one set for all of them.
layout(std430, set = 1, binding = 0) writeonly buffer RayMaterials
{
    RayMaterial rayMaterials[];
};

// Must match RayMaterialConstants in engine/renderer/vulkan/ray_scene.cpp.
layout(push_constant) uniform RayMaterialConstants
{
    vec4 baseColorFactor;
    vec4 emissiveAndCutoff; // rgb emissive factor, a alpha cutoff
    uvec4 params;           // x output index, y alpha mode, z flags, w transmission as float bits
}
constants;

const uint ALPHA_OPAQUE = 0u;
const uint ALPHA_MASK = 1u;

shared vec4 sharedAlbedo[256];   // rgb covered albedo sum, a covered count
shared vec4 sharedEmission[256]; // rgb emission sum, a coverage sum

float LodForSize(sampler2D image, float texels)
{
    float levels = float(textureQueryLevels(image));
    float width = float(textureSize(image, 0).x);
    return clamp(log2(max(width / texels, 1.0)), 0.0, levels - 1.0);
}

void main()
{
    uint index = gl_LocalInvocationIndex;
    vec2 uv = (vec2(gl_LocalInvocationID.xy) + 0.5) / 16.0;
    vec4 base = textureLod(baseColorTexture, uv, LodForSize(baseColorTexture, 16.0)) * constants.baseColorFactor;
    vec3 emission = textureLod(emissiveTexture, uv, LodForSize(emissiveTexture, 16.0)).rgb * constants.emissiveAndCutoff.rgb;

    float coverage = 1.0;
    if (constants.params.y == ALPHA_MASK)
    {
        coverage = base.a >= constants.emissiveAndCutoff.a ? 1.0 : 0.0;
    }
    else if (constants.params.y != ALPHA_OPAQUE)
    {
        coverage = clamp(base.a, 0.0, 1.0);
    }
    sharedAlbedo[index] = vec4(base.rgb * coverage, coverage);
    sharedEmission[index] = vec4(emission, coverage);
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (index < stride)
        {
            sharedAlbedo[index] += sharedAlbedo[index + stride];
            sharedEmission[index] += sharedEmission[index + stride];
        }
        barrier();
    }

    if (index == 0u)
    {
        vec4 albedoSum = sharedAlbedo[0];
        vec3 albedo = albedoSum.a > 0.0 ? albedoSum.rgb / albedoSum.a : constants.baseColorFactor.rgb;
        float transmission = uintBitsToFloat(constants.params.w);
        float meanCoverage = sharedEmission[0].a / 256.0 * (1.0 - transmission);
        RayMaterial material;
        material.albedoCoverage = vec4(clamp(albedo, 0.0, 1.0), meanCoverage);
        material.emissionFlags = vec4(sharedEmission[0].rgb / 256.0, uintBitsToFloat(constants.params.z));
        rayMaterials[constants.params.x] = material;
    }
}
